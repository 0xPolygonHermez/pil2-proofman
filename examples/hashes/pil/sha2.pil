require "std_constants.pil"
require "std_lookup.pil"

require "circuits/sha2.pil"

// Precompile in charge of performing the SHA2-256 compression
// For reference: Section 6.2 of https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf
//
// The compression itself lives in circuits/sha2.pil, shared with the recursion airs: every cell
// holds the same bit of SHA2_LANES (5) independent SHA2-256s. This air is the standalone shape:
// the whole trace is SHA2, so the lookups run on every row (SEL = 1) and the clocks only decide
// where the additions bind.
//
//    ROW      sa[0..32]     se[0..32]       sw[0..32]           STAGE
//  |  0   |      d      |      h      |        0         |   LOAD STATE    |
//  |  1   |      c      |      g      |        0         |   LOAD STATE    |
//  |  2   |      b      |      f      |        0         |   LOAD STATE    |
//  |  3   |      a      |      e      |        0         |   LOAD STATE    |
//  |  4+t |     a_t     |     e_t     |       W_t        |  ROUND t (0..63) |
//
// Rounds 0..15 load W_t (the message); rounds 16..63 extend it.

airtemplate Sha2(const int N = 2**19, const int FIXED_SELECTORS = 0) {
    const int CLOCKS = SHA2_CLOCKS;
    const int NUM_OPS = N / CLOCKS;
    if (NUM_OPS < 1) {
        error(`N must be at least ${CLOCKS} to fit the SHA2-256 arithmetization, but received N=${N}`);
    }
    println(`The total number of SHA2-256's with N = 2^${log2(N)} is ${NUM_OPS * SHA2_LANES}`);

    // Argument identifiers
    const int SHA2_P3_ID = 252;
    const int SHA2_CHR_ID = 253;
    const int SHA2_RANGE_ID = 254;
    const int SHA2_CARRY_ID = 255;

    expr MIX = 0;
    expr WCOMP = 0;
    expr KC[SHA2_NCHUNK];
    if (FIXED_SELECTORS) {
        // One fixed column per selector and per round-constant chunk: 6 more fixed columns, but
        // the quotient reads each once instead of summing 64 shifts of CLK_0.
        col fixed SHA2_MIX;
        col fixed SHA2_WCOMP;
        col fixed SHA2_KC[SHA2_NCHUNK];
        #pragma transpile
        for (int i = 0; i < N; i++) {
            const int c = i % CLOCKS;
            SHA2_MIX[i] = 0;
            SHA2_WCOMP[i] = 0;
            for (int j = 0; j < SHA2_NCHUNK; j++) { SHA2_KC[j][i] = 0; }
            if (i < NUM_OPS * CLOCKS && c >= SHA2_CLOCKS_LOAD_STATE) {
                const int rc = SHA2_RC[c - SHA2_CLOCKS_LOAD_STATE];
                SHA2_MIX[i] = 1;
                for (int j = 0; j < SHA2_NCHUNK; j++) {
                    SHA2_KC[j][i] = (rc >> (SHA2_CHUNK_BITS * j)) & (2**SHA2_CHUNK_BITS - 1);
                }
                if (c >= SHA2_CLOCKS_LOAD_STATE + SHA2_CLOCKS_LOAD_INPUT) { SHA2_WCOMP[i] = 1; }
            }
        }
        MIX = SHA2_MIX;
        WCOMP = SHA2_WCOMP;
        for (int j = 0; j < SHA2_NCHUNK; j++) { KC[j] = SHA2_KC[j]; }
    } else {
        // (i)'CLK_0 is 1 exactly on clock i of a used cycle, so the selectors and the round
        // constant vanish on the trailing rows that no cycle covers.
        col fixed CLK_0 = [[1, 0:(CLOCKS-1)]:NUM_OPS, 0...];
        for (int j = 0; j < SHA2_NCHUNK; j++) { KC[j] = 0; }
        for (int i = SHA2_CLOCKS_LOAD_STATE; i < CLOCKS; i++) {
            MIX = MIX + (i)'CLK_0;
            if (i >= SHA2_CLOCKS_LOAD_STATE + SHA2_CLOCKS_LOAD_INPUT) {
                WCOMP = WCOMP + (i)'CLK_0;
            }
            const int rc = SHA2_RC[i - SHA2_CLOCKS_LOAD_STATE];
            for (int j = 0; j < SHA2_NCHUNK; j++) {
                KC[j] = KC[j] + ((rc >> (SHA2_CHUNK_BITS * j)) & (2**SHA2_CHUNK_BITS - 1)) * (i)'CLK_0;
            }
        }
    }

    sha2Lanes(1, MIX, WCOMP, KC, SHA2_P3_ID, SHA2_CHR_ID, SHA2_RANGE_ID, SHA2_CARRY_ID);

    // After the lanes: the multiplicity columns are the trace's last ones.
    sha2Tables(N, SHA2_P3_ID, SHA2_CHR_ID, SHA2_RANGE_ID, SHA2_CARRY_ID);
}
