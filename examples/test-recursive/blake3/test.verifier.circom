pragma circom 2.1.0;
pragma custom_templates;

include "verifier/family_blake3.circom";

// The constraints at xi, one root each; the fold, Zi and the Q check are verifier/stark_verifier.circom's.
template parallel ConstraintRoots0() {
    signal input evals[23][3];
    signal input challenges[6][3];
    signal input publics[8];
    signal input proofvalues[2][3];
    signal input airvalues[3][3];
    signal input airgroupvalues[2][3];
    signal output roots[19][3];

    signal tmp_0[3] <== [evals[5][0] - publics[1], evals[5][1], evals[5][2]];
    signal tmp_1[3] <== CMul()(evals[3], tmp_0);
    signal tmp_2[3] <== [evals[6][0] - publics[2], evals[6][1], evals[6][2]];
    signal tmp_3[3] <== CMul()(evals[3], tmp_2);
    signal tmp_4[3] <== [evals[6][0] - publics[3], evals[6][1], evals[6][2]];
    signal tmp_5[3] <== CMul()(evals[14], tmp_4);
    signal tmp_6[3] <== [evals[16][0] - evals[6][0], evals[16][1] - evals[6][1], evals[16][2] - evals[6][2]];
    signal tmp_7[3] <== [1 - evals[14][0], -evals[14][1], -evals[14][2]];
    signal tmp_8[3] <== CMul()(tmp_6, tmp_7);
    signal tmp_9[3] <== [evals[19][0] - evals[17][0], evals[19][1] - evals[17][1], evals[19][2] - evals[17][2]];
    signal tmp_10[3] <== [1 - evals[18][0], -evals[18][1], -evals[18][2]];
    signal tmp_11[3] <== CMul()(tmp_9, tmp_10);
    signal tmp_12[3] <== [evals[22][0] - evals[20][0], evals[22][1] - evals[20][1], evals[22][2] - evals[20][2]];
    signal tmp_13[3] <== [1 - evals[21][0], -evals[21][1], -evals[21][2]];
    signal tmp_14[3] <== CMul()(tmp_12, tmp_13);
    signal tmp_15 <== publics[0] * proofvalues[0][0];
    signal tmp_16 <== tmp_15 - proofvalues[1][0];
    signal tmp_17 <== 2 * airvalues[0][0];
    signal tmp_18 <== tmp_17 - airvalues[1][0];
    signal tmp_19 <== airgroupvalues[0][0] - airvalues[0][0];
    signal tmp_20[3] <== [evals[3][0] * tmp_19, evals[3][1] * tmp_19, evals[3][2] * tmp_19];
    signal tmp_21[3] <== [1 + evals[2][0], evals[2][1],  evals[2][2]];
    signal tmp_22[3] <== [evals[1][0] - tmp_21[0], evals[1][1] - tmp_21[1], evals[1][2] - tmp_21[2]];
    signal tmp_23[3] <== [evals[5][0] * 2, evals[5][1] * 2, evals[5][2] * 2];
    signal tmp_24[3] <== [evals[6][0] + tmp_23[0], evals[6][1] + tmp_23[1], evals[6][2] + tmp_23[2]];
    signal tmp_25[3] <== [airvalues[0][0] + tmp_24[0], tmp_24[1],  tmp_24[2]];
    signal tmp_26[3] <== [evals[1][0] * 54, evals[1][1] * 54, evals[1][2] * 54];
    signal tmp_27[3] <== [tmp_25[0] + tmp_26[0], tmp_25[1] + tmp_26[1], tmp_25[2] + tmp_26[2]];
    signal tmp_28[3] <== [evals[3][0] * publics[1], evals[3][1] * publics[1], evals[3][2] * publics[1]];
    signal tmp_29[3] <== [tmp_27[0] + tmp_28[0], tmp_27[1] + tmp_28[1], tmp_27[2] + tmp_28[2]];
    signal tmp_30[3] <== [evals[7][0] - tmp_29[0], evals[7][1] - tmp_29[1], evals[7][2] - tmp_29[2]];
    signal tmp_31[3] <== [evals[8][0] - tmp_24[0], evals[8][1] - tmp_24[1], evals[8][2] - tmp_24[2]];
    signal tmp_32[3] <== [airvalues[0][0] + evals[8][0], evals[8][1],  evals[8][2]];
    signal tmp_33[3] <== [tmp_26[0] + tmp_32[0], tmp_26[1] + tmp_32[1], tmp_26[2] + tmp_32[2]];
    signal tmp_34[3] <== [tmp_28[0] + tmp_33[0], tmp_28[1] + tmp_33[1], tmp_28[2] + tmp_33[2]];
    signal tmp_35[3] <== [evals[9][0] - tmp_34[0], evals[9][1] - tmp_34[1], evals[9][2] - tmp_34[2]];
    signal tmp_36[3] <== [evals[7][0] - evals[9][0], evals[7][1] - evals[9][1], evals[7][2] - evals[9][2]];
    signal tmp_37[3] <== [tmp_7[0] - 1, tmp_7[1], tmp_7[2]];
    signal tmp_38[3] <== CMul()(tmp_7, tmp_37);
    signal tmp_39[3] <== CMul()(evals[11], evals[12]);
    signal tmp_40[3] <== [0 - tmp_7[0], -tmp_7[1], -tmp_7[2]];
    signal tmp_41[3] <== [tmp_39[0] - tmp_40[0], tmp_39[1] - tmp_40[1], tmp_39[2] - tmp_40[2]];
    signal tmp_42[3] <== [1 - evals[4][0], -evals[4][1], -evals[4][2]];
    signal tmp_43[3] <== CMul()(evals[0], tmp_42);
    signal tmp_44[3] <== [evals[10][0] - tmp_43[0], evals[10][1] - tmp_43[1], evals[10][2] - tmp_43[2]];
    signal tmp_45[3] <== [tmp_44[0] - evals[11][0], tmp_44[1] - evals[11][1], tmp_44[2] - evals[11][2]];
    signal tmp_46[3] <== [airgroupvalues[1][0] - evals[10][0], airgroupvalues[1][1] - evals[10][1], airgroupvalues[1][2] - evals[10][2]];
    signal tmp_47[3] <== CMul()(evals[15], tmp_46);
    signal tmp_48[3] <== CMul()(evals[17], challenges[0]);
    signal tmp_49[3] <== CMul()(evals[5], evals[5]);
    signal tmp_50[3] <== CMul()(evals[6], evals[6]);
    signal tmp_51[3] <== [tmp_49[0] + tmp_50[0], tmp_49[1] + tmp_50[1], tmp_49[2] + tmp_50[2]];
    signal tmp_52[3] <== [tmp_48[0] + tmp_51[0], tmp_48[1] + tmp_51[1], tmp_48[2] + tmp_51[2]];
    signal tmp_53[3] <== CMul()(challenges[0], tmp_52);
    signal tmp_54[3] <== [1 + tmp_53[0], tmp_53[1],  tmp_53[2]];
    signal tmp_55[3] <== [tmp_54[0] + challenges[1][0], tmp_54[1] + challenges[1][1], tmp_54[2] + challenges[1][2]];
    signal tmp_56[3] <== [evals[12][0] - tmp_55[0], evals[12][1] - tmp_55[1], evals[12][2] - tmp_55[2]];

    roots[0] <== tmp_1;
    roots[1] <== tmp_3;
    roots[2] <== tmp_5;
    roots[3] <== tmp_8;
    roots[4] <== tmp_11;
    roots[5] <== tmp_14;
    roots[6] <== [tmp_16, 0, 0];
    roots[7] <== [tmp_18, 0, 0];
    roots[8] <== tmp_20;
    roots[9] <== tmp_22;
    roots[10] <== tmp_30;
    roots[11] <== tmp_31;
    roots[12] <== tmp_35;
    roots[13] <== tmp_36;
    roots[14] <== tmp_38;
    roots[15] <== tmp_41;
    roots[16] <== tmp_45;
    roots[17] <== tmp_47;
    roots[18] <== tmp_56;
}
