require "std_permutation.pil"
require "module.pil"

public in1;
public in2;
public out;
public rom_root[4];

airtemplate Fibonacci(const int N = 2**10) {
    col fixed L1 = [1,0...];
    col witness a, b;

    // Inputs/Outputs
    L1 * (a - in1) === 0;
    L1 * (b - in2) === 0;
    L1' * (b - out) === 0;

    // Transition constraints
    (a' - b) * (1 - L1') === 0;
    // (The following are equivalent to the previous one)
    // (They are just to test more offsets)
    (a'(2) - b') * (1 - L1'(2)) === 0;
    (a'(3) - b'(2)) * (1 - L1'(3)) === 0;

    permutation_assumes(MODULE_ID, [a + b, b'], 1 - L1');

    // Test custom columns
    commit stage(0) public(rom_root) rom;

    col rom stage(0) line;
    col rom stage(0) flags;

    line - (flags + 1) === 0;

    // Test airvalues
    airval fibo1[2];
    airval stage(2) fibo3;

    2*fibo1[0] - fibo1[1] === 0;
    fibo3*fibo3 - 4 === 0; // TODO: I should be able to define constraints over extension fields

    // Test arrow function
    col witness test;
    col witness test2;
    col witness test3;

    test <== 2*a + b + fibo1[0];

    test2 <== 2*a + b;
    test3 <== test2 + fibo1[0];

    test === test3;
}
