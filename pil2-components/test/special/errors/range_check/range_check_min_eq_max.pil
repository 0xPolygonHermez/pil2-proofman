// Must fail to compile: range_validator rejects min == max (use a single-value check instead).

require "std_range_check.pil"

airtemplate RangeCheckMinEqMax(const int N = 2**4) {
    col witness x, sx;
    range_check(x, 7, 7, sx);  // ERROR: min == max
}

airgroup RangeCheckMinEqMax {
    RangeCheckMinEqMax();
}