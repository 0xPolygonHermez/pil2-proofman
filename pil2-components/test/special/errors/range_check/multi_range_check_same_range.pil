// Must fail to compile: multi_range_check rejects identical [min, max] for both ranges.

require "std_range_check.pil"

airtemplate MultiRangeCheckSameRange(const int N = 2**4) {
    col witness x, sx, rsel;
    multi_range_check(x, 0, 2**4-1, 0, 2**4-1, rsel, sx);  // ERROR: same range twice
}

airgroup MultiRangeCheckSameRange {
    MultiRangeCheckSameRange();
}