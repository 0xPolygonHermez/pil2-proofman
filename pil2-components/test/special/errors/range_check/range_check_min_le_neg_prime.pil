// Must fail to compile: range_validator rejects min <= -PRIME.
// range_size = 8 keeps us past the small-range warning branch.

require "std_range_check.pil"

airtemplate RangeCheckMinLeNegPrime(const int N = 2**4) {
    col witness x, sx;
    range_check(x, -PRIME, -PRIME + 7, sx);  // ERROR: min <= -PRIME
}

airgroup RangeCheckMinLeNegPrime {
    RangeCheckMinLeNegPrime();
}