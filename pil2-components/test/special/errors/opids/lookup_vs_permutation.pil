// Must fail to compile: a Lookup and a Permutation must not consume the same opid
// on the same (sum) bus — the std opid-overlap check rejects it.

require "std_lookup.pil"
require "std_permutation.pil"

airtemplate LookupVsPermutation(const int N = 2**4) {
    col witness x, sx;

    lookup_assumes(60, [x], sx);       // opid 60 owned by 'Lookup'
    permutation_assumes(60, [x], sx);  // ERROR: opid 60 now also consumed by 'Permutation'
}

airgroup LookupVsPermutation {
    LookupVsPermutation();
}