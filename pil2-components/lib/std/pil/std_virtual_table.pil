require "std_constants.pil"
require "std_lookup.pil"

int MAX_VIRTUAL_ROWS = 0; // Maximum number of rows. 
                          // 0 indicates that the number of rows is dynamically computed.

int MAX_NUM_VIRTUAL_TABLES = 1; // Maximum number of virtual tables

const int MAX_VIRTUAL_TABLE_WIDTH = 64;
const int MAX_VIRTUAL_TABLE_IDS = 16;
const int MAX_VIRTUAL_TABLE_GROUPS = 16;

function set_max_num_rows_virtual(const int rows) {
    if (rows <= 0) {
        error(`The input rows should be greater than 0, got ${rows} instead`);
    } else if ((rows & (rows - 1)) != 0) {
        error(`The input rows should be a power of two, got ${rows} instead`);
    }

    MAX_VIRTUAL_ROWS = rows;
}

function set_max_num_virtual_tables(const int num) {
    if (num <= 0) {
        error(`The input number of virtual tables should be greater than 0, got ${num} instead`);
    } else if (num == 1) {
        println("[Warning] The number of virtual tables is 1 by default. set_num_virtual_tables(1) has no effect.");
    }

    MAX_NUM_VIRTUAL_TABLES = num;
}

function set_group_virtual_tables(const int table_ids[]) {
    open_container_virtual_table();

    use airgroup.std.vt alias vt;

    const int n = length(table_ids);
    if (n == 0) {
        error("The input group cannot be empty");
    }

    for (int i = 0; i < n; i++) {
        const int table_id = table_ids[i];
        // Check for inner duplicates
        for (int j = i + 1; j < n; j++) {
            if (table_id == table_ids[j]) {
                error(`The table_ids must be unique, found duplicate ${table_id}`);
            }
        }

        // Check for outer duplicates
        for (int j = 0; j < vt.num_groups; j++) {
            for (int k = 0; k < vt.group_len[j]; k++) {
                if (vt.group[j][k] == table_id) {
                    error(`The table_ids must be unique across groups, found duplicate ${table_id}`);
                }
            }
        }

        vt.group[vt.num_groups][vt.group_len[vt.num_groups]] = table_id;
        vt.group_len[vt.num_groups]++;
    }

    vt.num_groups++;
}

function collect_virtual_table(const int opid, int table_id = -1, const expr table_cols[]) {
    // Use opid as the table_id when no explicit id is provided
    if (table_id == -1) {
        table_id = opid;
    }

    // Check the width
    const int w = length(table_cols);
    if (w == 0) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) is empty`);
    } else if (w > MAX_VIRTUAL_TABLE_WIDTH) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) exceeds maximum width`);
    }

    // Check the height
    const int h = Tables.num_rows(table_cols[0]);
    if (h == 0) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) is empty`);
    } else {
        // Check that all columns have the same number of rows
        for (int i = 1; i < w; i++) {
            if (Tables.num_rows(table_cols[i]) != h) {
                error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) has inconsistent number of rows`);
            }
        }
    }

    open_container_virtual_table();

    use airgroup.std.vt alias vt;

    // Check if the opid was already processed
    int opid_pos = -1;
    for (int i = 0; i < vt.num_opids; i++) {
        if (vt.opid[i] == opid) {
            opid_pos = i;
            break;
        }
    }

    // Process the table
    if (opid_pos == -1) {
        // The first time, we need to allocate a new entry
        for (int i = 0; i < w; i++) {
            vt.table_cols[vt.num_opids][0][i] = table_cols[i];
        }
        vt.opid[vt.num_opids] = opid;
        vt.table_id[vt.num_opids][0] = table_id;
        vt.table_height[vt.num_opids][0] = h;
        vt.num_tables[vt.num_opids] = 1;
        vt.width[vt.num_opids] = w;
        vt.height[vt.num_opids] = h;
        vt.total_height += h;
        vt.total_tables++;
        vt.num_opids++;
    } else {
        // Otherwise, update

        // Check width consistency
        if (vt.width[opid_pos] != w) {
            error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) has inconsistent width: expected ${vt.width[opid_pos]}, got ${w}`);
        }

        // If the table_id was already processed, error
        const int num_tables = vt.num_tables[opid_pos];
        for (int i = 0; i < num_tables; i++) {
            if (vt.table_id[opid_pos][i] == table_id) {
                error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) was already processed`);
            }
        }

        for (int i = 0; i < w; i++) {
            vt.table_cols[opid_pos][num_tables][i] = table_cols[i];
        }
        vt.table_id[opid_pos][num_tables] = table_id;
        vt.table_height[opid_pos][num_tables] = h;
        vt.num_tables[opid_pos]++;
        vt.height[opid_pos] += h;
        vt.total_height += h;
        vt.total_tables++;
    }

    // At the end, pack the tables
    on final(1) airgroup pack_tables();
}

function open_container_virtual_table() {
    container airgroup.std.vt {
        int opid[ARRAY_SIZE]; // One opid can be associated with multiple table_ids
        int table_id[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS];
        int table_height[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS];
        expr table_cols[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS][MAX_VIRTUAL_TABLE_WIDTH];
        int num_tables[ARRAY_SIZE];
        int width[ARRAY_SIZE];
        int height[ARRAY_SIZE];
        int num_opids = 0;
        int total_tables = 0;
        int total_height = 0;

        int group[MAX_VIRTUAL_TABLE_GROUPS][ARRAY_SIZE];
        int group_len[MAX_VIRTUAL_TABLE_GROUPS];
        int num_groups = 0;
    }
}

/*
    Given a set of tables Tᵢ := (uidᵢ, wᵢ, hᵢ), where  uidᵢ is the table uid, wᵢ is the width,
    and hᵢ is the height, this function packs the tables into a single table.

    The high-level idea is to first order the tables by width and then try to pack them
    assuming that:
      1. The height of the packing is a power of two.
      2. The only allowed operation is cutting the tables to stack them in some way.

    For example, if we have three tables T₁ = (0, 3, 2^10), T₂ = (1, 8, 2^4) and T₃ = (2, 4, 2^8), one option is to
    set the height to 2^9 and stack them as follows:
        =============================================================================================
         UID
        -------------------------                                            | #Fixed | #Witness(1) |
        | 0 | T₁[0] T₁[1] T₁[2] |                                            |   4    |      1      |
        ------------------------- ---> Bus                                   |        |             |
        -------------------------                                            |        |             |
        | 0 | T₁[0] T₁[1] T₁[2] |                                            |   4    |      1      |
        ------------------------- ---> Bus                                   |        |             |
        -------------------------------------------------------              |        |             |
        | 3 | T₃[0] T₃[1] T₃[2] T₃[3]   0     0     0     0   |              |   9    |      1      |
        | 2 | T₂[0] T₂[1] T₂[2] T₂[3] T₂[4] T₂[5] T₂[6] T₂[7] |              |        |             |
        | X |   0     0     0     0     0     0     0     0   |              |        |             |
        ------------------------------------------------------- ---> Bus     |        |             |
                                                                      Total: |   17   |      3      |
        =============================================================================================
    (NOTE: This is represented in vertical for space limitations, but the actual packing is horizontal)

    The size of the packing is chosen by trying to minimize the area of the resulting packing.
    Given the height of the resulting table T is H, the area of the packing is:
                        fixed_area   = H·∑ⱼ (1 + wⱼ) // UID + width
                        witness_area = H·((∑ⱼ 1) + 3 + 3*((∑ⱼ 1)//2)) // multiplicity + grand_sum + lookups_1
                        area         = fixed_area + witness_area
    where wⱼ is the width of the j-th group in the packing and ∑ⱼ 1 is the number of groups in the packing.

    NOTE: A table is never placed into two or more AIRs
*/
function pack_tables() {
    use airgroup.std.vt alias vt;

    // ========================================================================
    // 1. Flatten tables into parallel arrays for easier processing
    // ========================================================================
    const int flat_opid_idx[vt.total_tables];
    const int flat_table_idx[vt.total_tables];
    const int flat_table_id[vt.total_tables];
    const int flat_height[vt.total_tables];
    const int flat_width[vt.total_tables];
    
    int flat_offset = 0;
    for (int i = 0; i < vt.num_opids; i++) {
        for (int j = 0; j < vt.num_tables[i]; j++) {
            flat_opid_idx[flat_offset] = i;
            flat_table_idx[flat_offset] = j;

            flat_table_id[flat_offset] = vt.table_id[i][j];
            flat_height[flat_offset] = vt.table_height[i][j];
            flat_width[flat_offset] = vt.width[i];
            flat_offset++;
        }
    }

    // ========================================================================
    // 2. Sort tables: ascending width, then descending height (selection sort)
    // ========================================================================
    int ordered_tables[vt.total_tables];
    for (int i = 0; i < vt.total_tables; i++) {
        ordered_tables[i] = i;
    }
    for (int i = 0; i < vt.total_tables - 1; i++) {
        for (int j = i + 1; j < vt.total_tables; j++) {
            const int idx_i = ordered_tables[i];
            const int idx_j = ordered_tables[j];

            const int width_i = flat_width[idx_i];
            const int width_j = flat_width[idx_j];

            const int height_i = flat_height[idx_i];
            const int height_j = flat_height[idx_j];

            if ((width_i > width_j) || ((width_i == width_j) && (height_i < height_j))) {
                int tmp = ordered_tables[i];
                ordered_tables[i] = ordered_tables[j];
                ordered_tables[j] = tmp;
            }
        }
    }

    // ==============================================================================
    // 3. Resolve group assignments (ordered position → group index, -1 = ungrouped)
    // ==============================================================================
    int table_group[vt.total_tables];
    for (int k = 0; k < vt.total_tables; k++) { 
        table_group[k] = -1; 
    }

    // Initialize the tables with the already assigned groups
    for (int i = 0; i < vt.num_groups; i++) {
        const int group_len = vt.group_len[i];
        for (int j = 0; j < group_len; j++) {
            const int table_id = vt.group[i][j];

            // Find the table with this table_id
            int found = 0;
            for (int k = 0; k < vt.total_tables; k++) {
                const int idx = ordered_tables[k];
                if (flat_table_id[idx] == table_id) {
                    table_group[k] = i;
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                error(`The table_id ${table_id} specified in the group ${i} does not correspond to any virtual table`);
            }
        }
    }

    // ========================================================================
    // 4. Determine the minimum number of virtual tables needed
    // ========================================================================
    const int min_num_virtual_tables = (vt.num_groups > 0) ? vt.num_groups : 1;
    if (min_num_virtual_tables > MAX_NUM_VIRTUAL_TABLES) {
        error(`The specified number of groups (${vt.num_groups}) exceeds the maximum number of virtual tables (${MAX_NUM_VIRTUAL_TABLES}). Consider increasing the maximum number of virtual tables via set_max_num_virtual_tables()`);
    }

    // ========================================================================
    // 5. Distribute tables across virtual tables and compute optimal row counts
    //    We try each candidate num_vts ∈ [min_num_virtual_tables, MAX_NUM_VIRTUAL_TABLES]
    //    and pick the configuration with the smallest total area.
    // ========================================================================

    int best_total_area = -1;
    int best_num_rows = 0;
    int best_num_vts = min_num_virtual_tables;

    // Final assignment arrays
    int best_assignment[vt.total_tables]; // table i → virtual table index
    int best_vt_num_rows[MAX_NUM_VIRTUAL_TABLES];
    int best_vt_num_cols[MAX_NUM_VIRTUAL_TABLES];

    for (int candidate_vts = min_num_virtual_tables; candidate_vts <= MAX_NUM_VIRTUAL_TABLES; candidate_vts++) {
        // --- Distribute tables for this candidate ---
        int cand_assignment[vt.total_tables];
        int cand_vt_height[candidate_vts];
        int cand_vt_width[candidate_vts];
        int cand_vt_len[candidate_vts];

        // Initialize heights for pre-grouped tables
        for (int v = 0; v < candidate_vts; v++) {
            cand_vt_height[v] = 0;
            cand_vt_width[v] = 0;
            cand_vt_len[v] = 0;
        }
        for (int i = 0; i < vt.total_tables; i++) {
            cand_assignment[i] = -1;
        }

        // Place grouped tables first
        for (int i = 0; i < vt.total_tables; i++) {
            if (table_group[i] != -1) {
                const int idx = ordered_tables[i];
                const int group = table_group[i];
                cand_assignment[i] = group;
                cand_vt_height[group] += flat_height[idx];
                cand_vt_width[group] = (flat_width[idx] > cand_vt_width[group]) ? flat_width[idx] : cand_vt_width[group];
                cand_vt_len[group]++;
            }
        }

        // Distribute ungrouped tables using best-fit decreasing:
        //  - Keep user‑grouped tables already placed (preserve their relative order).
        //  - Append remaining tables in sorted order after the explicit group tables of that virtual table.
        //  - Respect the max height per virtual table except for the last one, which absorbs leftovers.
        const int cand_max_height = (vt.total_height + candidate_vts - 1) / candidate_vts;
        for (int i = 0; i < vt.total_tables; i++) {
            if (cand_assignment[i] != -1) continue; // already grouped

            const int idx = ordered_tables[i];
            const int height = flat_height[idx];
            const int width = flat_width[idx];

            int best_vt = -1;
            int best_remaining = -1;
            for (int j = 0; j < candidate_vts; j++) {
                const int is_last = (j == candidate_vts - 1);
                int capacity = cand_max_height - cand_vt_height[j];
                if (is_last) {
                    capacity = 1 << 30; // last VT absorbs overflow
                }
                if (height <= capacity) {
                    const int remaining_after = capacity - height;
                    if (best_vt == -1 || remaining_after < best_remaining) {
                        best_vt = j;
                        best_remaining = remaining_after;
                        if (best_remaining == 0) break;
                    }
                }
            }
            if (best_vt == -1) {
                best_vt = candidate_vts - 1;
            }

            cand_assignment[i] = best_vt;
            cand_vt_height[best_vt] += height;
            cand_vt_width[best_vt] = (width > cand_vt_width[best_vt]) ? width : cand_vt_width[best_vt];
            cand_vt_len[best_vt]++;
        }

        // --- Compute per-VT row counts and total area ---
        int cand_total_rows = 0;
        int cand_total_area = 0;
        int cand_vt_num_rows[candidate_vts];
        int cand_vt_num_cols[candidate_vts];
        int candidate_valid = 1;

        for (int v = 0; v < candidate_vts; v++) {
            if (cand_vt_height[v] == 0) {
                // Empty VT: zero area, minimal rows
                cand_vt_num_rows[v] = 0;
                continue;
            }

            // Determine row count for this VT
            int vt_rows = 1;
            while (vt_rows < cand_vt_height[v]) {
                vt_rows *= 2;
            }
            // If the height exceeds the maximum allowed rows, this candidate is invalid
            if ((MAX_VIRTUAL_ROWS != 0) && (vt_rows > MAX_VIRTUAL_ROWS)) {
                vt_rows = MAX_VIRTUAL_ROWS;
            }
            cand_total_rows += vt_rows;
            cand_vt_num_rows[v] = vt_rows;
            cand_vt_num_cols[v] = cand_vt_width[v];

            // Compute area
            const int vt_area = cand_vt_num_rows[v] * cand_vt_num_cols[v];
            cand_total_area += vt_area;
        }

        // --- Check if this candidate is better ---
        if (candidate_valid && (best_total_area == -1 || cand_total_area < best_total_area)) {
            best_num_rows = cand_total_rows;
            best_total_area = cand_total_area;
            best_num_vts = candidate_vts;
            for (int i = 0; i < vt.total_tables; i++) {
                best_assignment[i] = cand_assignment[i];
            }
            for (int v = 0; v < candidate_vts; v++) {
                best_vt_num_rows[v] = cand_vt_num_rows[v];
                best_vt_num_cols[v] = cand_vt_num_cols[v];
            }
        }
    }

    const int num_virtual_tables = best_num_vts;
    println(`[Debug] Generating ${num_virtual_tables} Virtual Tables with total Height=${best_num_rows} and total Area=${best_total_area}`);
    for (int v = 0; v < num_virtual_tables; v++) {
        println(`[Debug]  - VirtualTable #${v}: Height=2^${log2(best_vt_num_rows[v])}, Width=${best_vt_num_cols[v]}, Area=${best_vt_num_rows[v] * best_vt_num_cols[v]}`);
    }

    // ========================================================================
    // 6. Build the final ordered lists per virtual table
    // ========================================================================
    const int ordered_tables_air[num_virtual_tables][vt.total_tables];
    int ordered_tables_air_height[num_virtual_tables];
    int ordered_tables_air_len[num_virtual_tables];
    for (int i = 0; i < vt.total_tables; i++) {
        const int idx = ordered_tables[i];
        const int tgt = best_assignment[i];
        const int pos = ordered_tables_air_len[tgt];

        ordered_tables_air[tgt][pos] = idx;
        ordered_tables_air_height[tgt] += flat_height[idx];
        ordered_tables_air_len[tgt]++;
    }

    // ========================================================================
    // 7. Instantiate the virtual tables
    // ========================================================================

    // Store the airgroup_ids and air_ids
    container proof.std.vt {
        int airgroup_ids[num_virtual_tables];
        int air_ids[num_virtual_tables];
    }

    // Instantiate
    for (int i = 0; i < num_virtual_tables; i++) {
        const int total_height_air = ordered_tables_air_height[i];
        const int num_tables_air = ordered_tables_air_len[i];
        const int total_num_rows = best_vt_num_rows[i];

        if (total_height_air == 0) {
            println(`[Warning] VirtualTable_${AIRGROUP_ID}_${i} is empty, skipping`);
            continue;
        }

        // Compute packing groups
        const int num_packing_groups = (total_height_air + total_num_rows - 1) / total_num_rows;
        if (num_packing_groups > ARRAY_SIZE) {
            error(`VirtualTable_${AIRGROUP_ID}_${i}: rows=${total_num_rows} generates too many groups=${num_packing_groups} > max=${ARRAY_SIZE}. Consider setting more rows via set_max_num_rows_virtual()`);
        }

        // Compute the packing
        int uids_pack[num_packing_groups][num_tables_air];
        int tables_pack[num_packing_groups][num_tables_air];
        int widths_pack[num_packing_groups];
        int lens_pack[num_packing_groups];
        int used_area[num_packing_groups];
        int available_height = total_num_rows;
        int offset = 0;
        for (int j = 0; j < num_tables_air; j++) {
            const int idx = ordered_tables_air[i][j];
            const int opid_idx = flat_opid_idx[idx];
            const int width = flat_width[idx];
            int height = flat_height[idx];

            while (height > 0) {
                if (height <= available_height) {
                    // It fits entirely
                    available_height -= height;
                    used_area[offset] += width * height;
                    height = 0;
                } else {
                    // Only part fits, so cut and place what we can
                    height -= available_height;
                    used_area[offset] += width * available_height;
                    available_height = 0;
                }

                // Update the uids and the number of tables in the current group
                tables_pack[offset][lens_pack[offset]] = idx;
                uids_pack[offset][lens_pack[offset]] = vt.opid[opid_idx];
                lens_pack[offset]++;

                if (available_height == 0) {
                    // Close the current table
                    widths_pack[offset] = width; // Since they are ordered by width,
                                                 // the width representative is the last one that fits
                    offset++;

                    // Start a new table
                    available_height = total_num_rows;
                }
            }
        }

        // If the last table is partially filled, we need to add a complete new table
        if (available_height < total_num_rows) {
            widths_pack[offset] = flat_width[ordered_tables_air[i][num_tables_air - 1]];
        }

        // Debug: compute and print area breakdown
        int wasted_area = 0;
        int fixed_area = 0;
        for (int j = 0; j < num_packing_groups; j++) {
            wasted_area += total_num_rows*widths_pack[j] - used_area[j];
            fixed_area += (1 + widths_pack[j]);
        }
        const int witness_area = (num_packing_groups + 3 + 3 * (num_packing_groups / 2));
        const int area = total_num_rows * (fixed_area + witness_area);

        println(`[Debug] VirtualTable_${AIRGROUP_ID}_${i}: N=2^${log2(total_num_rows)}, groups=${num_packing_groups}, area=${area}, wasted=${wasted_area}`);

        VirtualTable(total_num_rows, ordered_tables_air[i], num_tables_air, total_height_air,
                     uids_pack, tables_pack, widths_pack, lens_pack, num_packing_groups, i,
                     flat_opid_idx, flat_table_idx, flat_table_id, flat_height, flat_width) alias `VirtualTable_${AIRGROUP_ID}_${i}`;
    }
}

airtemplate VirtualTable(const int N, const int tables[], const int num_tables, const int total_height, 
                         const int uids[][], const int table_idxs[][], const int widths[], const int lens[], 
                         const int num_groups, const int vt_idx,
                         const int flat_opid_idx[], const int flat_table_idx[], const int flat_table_id[], const int flat_height[], const int flat_width[]) {   
    // Compute the number of fixed and witness columns
    int sum_widths = 0;
    for (int i = 0; i < num_groups; i++) {
        sum_widths += widths[i];
    }

    col fixed UID[num_groups];
    col fixed column[sum_widths];
    col witness multiplicity[num_groups];

    // Issue hint information
    int flatten_table_ids[num_tables];
    int acc_heights[num_tables];
    int acc_total_height = 0;

    println(`[Debug] ${AIR_NAME} instantiated with: N=2^${log2(N)}, #Fixed=${num_groups + sum_widths}, #Witness=${num_groups}`);
    println(`[Debug] Table composition (total height of ${total_height}):`);
    for (int i = 0; i < num_tables; i++) {
        const int idx = tables[i];
        const int table_id = flat_table_id[idx];
        const int height = flat_height[idx];
        const int width = flat_width[idx];

        flatten_table_ids[i] = table_id;
        acc_heights[i] = acc_total_height;
        acc_total_height += height;
        println(`[Debug]    - Table ${table_id} with height=${height} and width=${width}`);
    }
    @virtual_table_data{table_ids: flatten_table_ids, acc_heights: acc_heights, num_muls: num_groups};

    // Prove the groups
    int col_offset = 0;
    int row_start = 0;
    for (int i = 0; i < num_groups; i++) {
        const int group_len = lens[i];
        const int group_width = widths[i];

        int group_row_offset = 0;
        for (int j = 0; j < group_len; j++) {
            const int idx = table_idxs[i][j];
            const int opid_idx = flat_opid_idx[idx];
            const int table_idx = flat_table_idx[idx];
            const int height = flat_height[idx];
            const int width = flat_width[idx];
            const int uid = uids[i][j];

            // Fill the UID column. Ensure the height does not exceed N
            const int height_remaining = height - row_start;
            const int N_remaining = N - group_row_offset;
            const int h = (height_remaining <= N_remaining) ? height_remaining : N_remaining;
            Tables.fill(uid, UID[i], group_row_offset, h);

            // Fill the table columns
            for (int l = 0; l < width; l++) {
                Tables.copy(vt.table_cols[opid_idx][table_idx][l], row_start, column[col_offset + l], group_row_offset, h);
            }

            // Update the row offset
            group_row_offset += h;

            // Update the row start
            if (height_remaining <= N_remaining) {
                row_start = 0;
            } else {
                row_start += h;
            }
        }

        int uids_to_prove[group_len];
        for (int j = 0; j < group_len; j++) {
            uids_to_prove[j] = uids[i][j];
        }

        expr cols_to_prove[group_width];
        for (int j = 0; j < group_width; j++) {
            cols_to_prove[j] = column[col_offset + j];
        }

        // Perform the proving
        lookup_proves_dynamic(opids: uids_to_prove, busid: UID[i], expressions: cols_to_prove, mul: multiplicity[i]);

        // Update the column offset
        col_offset += group_width;
    }

    // save the airgroup id and air id of the table for latter use
    proof.std.vt.airgroup_ids[vt_idx] = AIRGROUP_ID;
    proof.std.vt.air_ids[vt_idx] = AIR_ID;

    on final proof issue_virtual_table_data_global();
}

private function issue_virtual_table_data_global() {
    use proof.std.vt;
    @virtual_table_data_global{airgroup_ids: airgroup_ids, air_ids: air_ids};
}