require "std_constants.pil"
require "std_lookup.pil"

int MAX_VIRTUAL_BITS = 0; // Maximum number of bits per column length in the virtual table
                          // 0 indicates that the number of rows is dynamically computed.

int NUM_VIRTUAL_TABLES = 1; // Number of virtual tables

// Per-column proof overhead expressed as a percentage of max_N for this virtual table.
// Captures the fixed cost of adding a polynomial to the proof
const int COLUMN_PROOF_OVERHEAD_PCT = 10;

const int MAX_VIRTUAL_TABLE_WIDTH = 64;
const int MAX_VIRTUAL_TABLE_IDS = 16;
const int MAX_VIRTUAL_TABLE_GROUPS = 16;

function set_max_bits_virtual_tables(const int bits) {
    if (bits <= 1) {
        error(`The input bits should be greater than 1, got ${bits} instead`);
    } else if (bits > log2(PRIME)) {
        error(`The input bits should be less than or equal to ${log2(PRIME)}, got ${bits} instead`);
    }

    MAX_VIRTUAL_BITS = bits;
}

function set_num_virtual_tables(const int num) {
    if (num <= 1) {
        error(`The input number of virtual tables should be greater than 1, got ${num} instead`);
    }

    NUM_VIRTUAL_TABLES = num;
}

function set_group_virtual_tables(const int table_ids[]) {
    open_container_virtual_table();

    use airgroup.std.vt alias vt;

    const int n = length(table_ids);
    if (n == 0) {
        error("The input group cannot be empty");
    }

    for (int i = 0; i < n; i++) {
        const int table_id = table_ids[i];
        // Check for inner duplicates
        for (int j = i + 1; j < n; j++) {
            if (table_id == table_ids[j]) {
                error(`The table_ids must be unique, found duplicate ${table_id}`);
            }
        }

        // Check for outer duplicates
        for (int j = 0; j < vt.num_groups; j++) {
            for (int k = 0; k < vt.group_len[j]; k++) {
                if (vt.group[j][k] == table_id) {
                    error(`The table_ids must be unique across groups, found duplicate ${table_id}`);
                }
            }
        }

        vt.group[vt.num_groups][vt.group_len[vt.num_groups]] = table_id;
        vt.group_len[vt.num_groups]++;
    }

    vt.num_groups++;
}

function collect_virtual_table(const int opid, int table_id = -1, const expr table_cols[]) {
    // Use opid as the table_id when no explicit id is provided
    if (table_id == -1) {
        table_id = opid;
    }

    // Check the width
    const int w = length(table_cols);
    if (w == 0) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) is empty`);
    } else if (w > MAX_VIRTUAL_TABLE_WIDTH) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) exceeds maximum width`);
    }

    // Check the height
    const int h = Tables.num_rows(table_cols[0]);
    if (h == 0) {
        error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) is empty`);
    } else {
        // Check that all columns have the same number of rows
        for (int i = 1; i < w; i++) {
            if (Tables.num_rows(table_cols[i]) != h) {
                error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) has inconsistent number of rows`);
            }
        }
    }

    open_container_virtual_table();

    use airgroup.std.vt alias vt;

    // Check if the opid was already processed
    int opid_pos = -1;
    for (int i = 0; i < vt.num_opids; i++) {
        if (vt.opid[i] == opid) {
            opid_pos = i;
            break;
        }
    }

    // Process the table
    if (opid_pos == -1) {
        // The first time, we need to allocate a new entry
        for (int i = 0; i < w; i++) {
            vt.table_cols[vt.num_opids][0][i] = table_cols[i];
        }
        vt.opid[vt.num_opids] = opid;
        vt.table_id[vt.num_opids][0] = table_id;
        vt.table_height[vt.num_opids][0] = h;
        vt.num_tables[vt.num_opids] = 1;
        vt.width[vt.num_opids] = w;
        vt.height[vt.num_opids] = h;
        vt.total_height += h;
        vt.total_tables++;
        vt.num_opids++;
    } else {
        // Otherwise, update

        // Check width consistency
        if (vt.width[opid_pos] != w) {
            error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) has inconsistent width: expected ${vt.width[opid_pos]}, got ${w}`);
        }

        // If the table_id was already processed, error
        const int num_tables = vt.num_tables[opid_pos];
        for (int i = 0; i < num_tables; i++) {
            if (vt.table_id[opid_pos][i] == table_id) {
                error(`Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP_ID}, ${AIR_ID}) was already processed`);
            }
        }

        for (int i = 0; i < w; i++) {
            vt.table_cols[opid_pos][num_tables][i] = table_cols[i];
        }
        vt.table_id[opid_pos][num_tables] = table_id;
        vt.table_height[opid_pos][num_tables] = h;
        vt.num_tables[opid_pos]++;
        vt.height[opid_pos] += h;
        vt.total_height += h;
        vt.total_tables++;
    }

    if (DEBUG_MODE_PRINT) {
        println(`[Debug] Collected Virtual Table #${table_id} on (AIRGROUP, AIR) = (${AIRGROUP}, ${AIR_NAME}) with Height=${h} and Width=${w}`);
    }

    // At the end, pack the tables
    on final(1) airgroup pack_tables();
}

function open_container_virtual_table() {
    container airgroup.std.vt {
        int opid[ARRAY_SIZE]; // One opid can be associated with multiple table_ids
        int table_id[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS];
        int table_height[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS];
        expr table_cols[ARRAY_SIZE][MAX_VIRTUAL_TABLE_IDS][MAX_VIRTUAL_TABLE_WIDTH];
        int num_tables[ARRAY_SIZE];
        int width[ARRAY_SIZE];
        int height[ARRAY_SIZE];
        int num_opids = 0;
        int total_tables = 0;
        int total_height = 0;

        int group[MAX_VIRTUAL_TABLE_GROUPS][ARRAY_SIZE];
        int group_len[MAX_VIRTUAL_TABLE_GROUPS];
        int num_groups = 0;
    }
}

/*
    Given a set of tables Tᵢ := (uidᵢ, wᵢ, hᵢ), where  uidᵢ is the table uid, wᵢ is the width,
    and hᵢ is the height, this function packs the tables into a single table.

    The high-level idea is to first order the tables by width and then try to pack them
    assuming that:
      1. The height of the packing is a power of two.
      2. The only allowed operation is cutting the tables to stack them in some way.

    For example, if we have three tables T₁ = (0, 3, 2^10), T₂ = (1, 8, 2^4) and T₃ = (2, 4, 2^8), one option is to
    set the height to 2^9 and stack them as follows:
        =============================================================================================
         UID
        -------------------------                                            | #Fixed | #Witness(1) |
        | 0 | T₁[0] T₁[1] T₁[2] |                                            |   4    |      1      |
        ------------------------- ---> Bus                                   |        |             |
        -------------------------                                            |        |             |
        | 0 | T₁[0] T₁[1] T₁[2] |                                            |   4    |      1      |
        ------------------------- ---> Bus                                   |        |             |
        -------------------------------------------------------              |        |             |
        | 3 | T₃[0] T₃[1] T₃[2] T₃[3]   0     0     0     0   |              |   9    |      1      |
        | 2 | T₂[0] T₂[1] T₂[2] T₂[3] T₂[4] T₂[5] T₂[6] T₂[7] |              |        |             |
        | X |   0     0     0     0     0     0     0     0   |              |        |             |
        ------------------------------------------------------- ---> Bus     |        |             |
                                                                      Total: |   17   |      3      |
        =============================================================================================
    (NOTE: This is represented in vertical for space limitations, but the actual packing is horizontal)
*/
function pack_tables() {
    use airgroup.std.vt alias vt;

    // ========================================================================
    // 1. Flatten tables into parallel arrays for easier processing
    // ========================================================================
    const int flat_opid_idx[vt.total_tables];
    const int flat_table_idx[vt.total_tables];
    const int flat_table_id[vt.total_tables];
    const int flat_height[vt.total_tables];
    const int flat_width[vt.total_tables];
    
    int flat_offset = 0;
    for (int i = 0; i < vt.num_opids; i++) {
        for (int j = 0; j < vt.num_tables[i]; j++) {
            flat_opid_idx[flat_offset] = i;
            flat_table_idx[flat_offset] = j;

            flat_table_id[flat_offset] = vt.table_id[i][j];
            flat_height[flat_offset] = vt.table_height[i][j];
            flat_width[flat_offset] = vt.width[i];
            flat_offset++;
        }
    }

    // ========================================================================
    // 2. Sort tables: ascending width, then descending height (selection sort)
    // ========================================================================
    int ordered_tables[vt.total_tables];
    for (int i = 0; i < vt.total_tables; i++) {
        ordered_tables[i] = i;
    }
    for (int i = 0; i < vt.total_tables - 1; i++) {
        for (int j = i + 1; j < vt.total_tables; j++) {
            const int idx_i = ordered_tables[i];
            const int idx_j = ordered_tables[j];

            const int width_i = flat_width[idx_i];
            const int width_j = flat_width[idx_j];

            const int height_i = flat_height[idx_i];
            const int height_j = flat_height[idx_j];

            if ((width_i > width_j) || ((width_i == width_j) && (height_i < height_j))) {
                int tmp = ordered_tables[i];
                ordered_tables[i] = ordered_tables[j];
                ordered_tables[j] = tmp;
            }
        }
    }

    // ==============================================================================
    // 3. Resolve group assignments (ordered position → group index, -1 = ungrouped)
    // ==============================================================================
    int table_group[vt.total_tables];
    for (int k = 0; k < vt.total_tables; k++) { 
        table_group[k] = -1; 
    }

    // Initialize the tables with the already assigned groups
    for (int i = 0; i < vt.num_groups; i++) {
        const int group_len = vt.group_len[i];
        for (int j = 0; j < group_len; j++) {
            const int table_id = vt.group[i][j];

            // Find the table with this table_id
            int found = 0;
            for (int k = 0; k < vt.total_tables; k++) {
                const int idx = ordered_tables[k];
                if (flat_table_id[idx] == table_id) {
                    table_group[k] = i;
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                error(`The table_id ${table_id} specified in the group ${i} does not correspond to any virtual table`);
            }
        }
    }

    // ========================================================================
    // 4. Distribute tables across virtual tables and compute optimal row counts
    // ========================================================================
    const int num_virtual_tables = (vt.num_groups > NUM_VIRTUAL_TABLES) ? vt.num_groups : NUM_VIRTUAL_TABLES;

    // Assignment
    int assignment[vt.total_tables];
    int vt_area[num_virtual_tables];
    int vt_len[num_virtual_tables];

    // Initialize data structures for this candidate
    for (int i = 0; i < vt.total_tables; i++) {
        assignment[i] = -1;
    }
    for (int v = 0; v < num_virtual_tables; v++) {
        vt_area[v] = 0;
        vt_len[v] = 0;
    }

    // Place grouped tables first
    for (int i = 0; i < vt.total_tables; i++) {
        if (table_group[i] != -1) {
            const int idx = ordered_tables[i];
            const int group = table_group[i];
            assignment[i] = group;
            vt_area[group] += flat_height[idx] * flat_width[idx];
            vt_len[group]++;
        }
    }

    // Compute the total area (Σ height·width)
    int total_area = 0;
    for (int i = 0; i < vt.total_tables; i++) {
        total_area += flat_height[i] * flat_width[i];
    }

    // Distribute ungrouped tables using best-fit decreasing on area:
    //  - Keep user‑grouped tables already placed (preserve their relative order).
    //  - Append remaining tables in sorted order after the explicit group tables of that virtual table.
    //  - Respect the max area per virtual table except for the last one, which absorbs leftovers.
    const int max_area_per_vt = (total_area + num_virtual_tables - 1) / num_virtual_tables;
    for (int i = 0; i < vt.total_tables; i++) {
        if (assignment[i] != -1) continue; // already grouped

        const int idx = ordered_tables[i];
        const int height = flat_height[idx];
        const int width = flat_width[idx];
        const int area = height * width;

        int best_pos = -1;
        int best_remaining = -1;
        for (int j = 0; j < num_virtual_tables; j++) {
            const int is_last = (j == num_virtual_tables - 1);
            int capacity = max_area_per_vt - vt_area[j];
            if (is_last) {
                capacity = 1 << 50; // last VT absorbs overflow
            }
            if (area <= capacity) {
                const int remaining_after = capacity - area;
                if (best_pos == -1 || remaining_after < best_remaining) {
                    best_pos = j;
                    best_remaining = remaining_after;
                    if (best_remaining == 0) break;
                }
            }
        }
        if (best_pos == -1) {
            best_pos = num_virtual_tables - 1;
        }

        assignment[i] = best_pos;
        vt_area[best_pos] += area;
        vt_len[best_pos]++;
    }

    // ========================================================================
    // 5. Build the final ordered lists per virtual table
    // ========================================================================
    const int ordered_tables_air[num_virtual_tables][vt.total_tables];
    int ordered_tables_air_height[num_virtual_tables];
    int ordered_tables_air_len[num_virtual_tables];
    for (int i = 0; i < vt.total_tables; i++) {
        const int idx = ordered_tables[i];
        const int tgt = assignment[i];
        const int pos = ordered_tables_air_len[tgt];

        ordered_tables_air[tgt][pos] = idx;
        ordered_tables_air_height[tgt] += flat_height[idx];
        ordered_tables_air_len[tgt]++;
    }

    // ========================================================================
    // 6. Instantiate the virtual tables
    // ========================================================================

    // Store the airgroup_ids and air_ids
    container proof.std.vt {
        int airgroup_ids[num_virtual_tables];
        int air_ids[num_virtual_tables];
    }

    if (DEBUG_MODE_PRINT) {
        println(`[Debug] Packing ${vt.total_tables} input tables with Height=${vt.total_height} and Area=${total_area} into virtual tables:`);
        println(`[Debug]   - User-defined groups: ${vt.num_groups}`);
        println(`[Debug]   - Number of virtual tables: ${num_virtual_tables}`);
        println(`[Debug]   - Target area per virtual table: ${max_area_per_vt}`);
        println("");
        println(`[Debug] Assignment after table distribution:`);
        for (int i = 0; i < num_virtual_tables; i++) {
            println(`[Debug]   - Virtual Table #${i}: Tables=${ordered_tables_air_len[i]}, Height=${ordered_tables_air_height[i]}, Area=${vt_area[i]}`);
        }
        println("");
        println(`[Debug] Generating ${num_virtual_tables} virtual tables...`);
        println(`[Debug]`);
    }

    // Instantiate
    for (int i = 0; i < num_virtual_tables; i++) {
        const int total_height_air = ordered_tables_air_height[i];
        const int num_tables_air = ordered_tables_air_len[i];

        if (total_height_air == 0) {
            println(`[Warning] Virtual Table #${i} is empty, skipping`);
            continue;
        }

        // We now need to choose the number of rows N for this virtual table. 
        // This is a critical parameter that affects the proof cost, as it determines how
        // the tables are packed and how many columns are needed. We choose N as the one
        // that minimises the cost of the resulting packing among all powers of 2.
        // The cost is estimated as:
        //      total_columns * (candidate_N + column_overhead)
        // where column_overhead is a fixed per-column penalty that accounts for the
        // proof cost of adding a polynomial independently of N.
        // Without this term, minimising by area alone would always favour N=1.
        //
        // Given the height of the resulting table T is H, the area is computed as:
        //                     fixed_area   = H·∑ⱼ (1 + wⱼ) // UID + width
        //                     witness_area = H·((∑ⱼ 1) + 3 + 3*((∑ⱼ 1)//2)) // multiplicity + grand_sum + lookups_1
        //                     area         = fixed_area + witness_area
        // where wⱼ is the width of the j-th group in the packing and ∑ⱼ 1 is the number of groups in the packing.

        // Compute the smallest power of 2 >= total_height_air as the upper bound for N
        int max_N = 1;
        while (max_N < total_height_air) {
            max_N *= 2;
        }
        if (MAX_VIRTUAL_BITS != 0 && max_N > (1 << MAX_VIRTUAL_BITS)) {
            max_N = 1 << MAX_VIRTUAL_BITS;
        }

        // Find the minimum table height in this VT to use as lower bound
        int min_table_height = flat_height[ordered_tables_air[i][0]];
        for (int j = 1; j < num_tables_air; j++) {
            const int idx = ordered_tables_air[i][j];
            if (flat_height[idx] < min_table_height) {
                min_table_height = flat_height[idx];
            }
        }

        // Start from smallest power-of-two >= min_table_height
        // (going below the smallest table never helps — it just splits it unnecessarily)
        int min_N = 1;
        while (min_N < min_table_height) {
            min_N *= 2;
        }

            if (DEBUG_MODE_PRINT) {
                println(`[Debug] Choosing the best power of two N for Virtual Table #${i} with Height=${total_height_air} and Tables=${num_tables_air} between $2^{log2(min_N)} and 2^${log2(max_N)}...`);
            }

        // Column overhead
        const int column_overhead  = max_N * COLUMN_PROOF_OVERHEAD_PCT / 100;

        int best_total_num_rows = max_N;
        int best_total_cols = 0;
        int best_cost = -1; // -1 = uninitialised

        int candidate_N = min_N;
        while (candidate_N <= max_N) {
            // Simulate packing
            int sim_num_groups    = 0;
            int sim_fixed_cols = 0;
            int sim_available     = candidate_N;

            for (int j = 0; j < num_tables_air; j++) {
                const int idx   = ordered_tables_air[i][j];
                const int width = flat_width[idx];
                int height      = flat_height[idx];

                // Place what fits in the current partial group
                if (sim_available > 0 && height > 0) {
                    const int placed = (height <= sim_available) ? height : sim_available;
                    height -= placed;
                    sim_available -= placed;

                    if (sim_available == 0) {
                        sim_fixed_cols += (1 + width);
                        sim_num_groups++;
                        sim_available = candidate_N;
                    }
                }

                // Remaining height: compute full groups and leftover via division
                if (height > 0) {
                    const int full_groups = height / candidate_N;
                    const int leftover    = height - full_groups * candidate_N;

                    sim_fixed_cols += full_groups * (1 + width);
                    sim_num_groups    += full_groups;

                    if (leftover > 0) {
                        sim_available = candidate_N - leftover;
                    }
                    // if leftover == 0, sim_available remains candidate_N
                }
            }

            // Close the last (possibly partial) group
            if (sim_available < candidate_N) {
                const int last_idx = ordered_tables_air[i][num_tables_air - 1];
                sim_fixed_cols += (1 + flat_width[last_idx]);
                sim_num_groups++;
            }

            // Compute the cost
            const int sim_witness_cols = sim_num_groups + 3 + 3*((sim_num_groups + 1)/2);
            const int sim_total_cols   = sim_fixed_cols + sim_witness_cols;
            const int sim_cost         = sim_total_cols * (candidate_N + column_overhead);

            if (best_cost == -1 || sim_cost < best_cost) {
                best_cost           = sim_cost;
                best_total_num_rows = candidate_N;
                best_total_cols     = sim_total_cols;
            }

            if (DEBUG_MODE_PRINT) {
                const int sim_area = sim_total_cols * candidate_N;
                println(`[Debug]    - Candidate N=2^${log2(candidate_N)}: Splits=${sim_num_groups}, Cols=${sim_total_cols}, Area=${sim_area}, Cost=${sim_cost}`);
            }

            candidate_N *= 2;
        }

        if (DEBUG_MODE_PRINT) {
            println(`[Debug] Chosen N=2^${log2(best_total_num_rows)} for Virtual Table #${i} with Cost=${best_cost}`);
        }

        // Use the cost-optimal N for the actual packing below.
        const int total_num_rows = best_total_num_rows;

        // Compute packing groups
        const int num_packing_groups = (total_height_air + total_num_rows - 1) / total_num_rows;
        if (num_packing_groups > ARRAY_SIZE) {
            error(`Virtual Table #${i}: rows=${total_num_rows} generates too many groups=${num_packing_groups} > max=${ARRAY_SIZE}. Consider setting more bits via set_max_bits_virtual_tables()`);
        }

        // Compute the packing
        int uids_pack[num_packing_groups][num_tables_air];
        int tables_pack[num_packing_groups][num_tables_air];
        int widths_pack[num_packing_groups];
        int lens_pack[num_packing_groups];
        int available_height = total_num_rows;
        int offset = 0;
        for (int j = 0; j < num_tables_air; j++) {
            const int idx = ordered_tables_air[i][j];
            const int opid_idx = flat_opid_idx[idx];
            const int width = flat_width[idx];
            int height = flat_height[idx];

            while (height > 0) {
                if (height <= available_height) {
                    // It fits entirely
                    available_height -= height;
                    height = 0;
                } else {
                    // Only part fits, so cut and place what we can
                    height -= available_height;
                    available_height = 0;
                }

                // Update the uids and the number of tables in the current group
                tables_pack[offset][lens_pack[offset]] = idx;
                uids_pack[offset][lens_pack[offset]] = vt.opid[opid_idx];
                lens_pack[offset]++;

                if (available_height == 0) {
                    // Close the current table
                    widths_pack[offset] = width; // Since they are ordered by width,
                                                 // the width representative is the last one that fits
                    offset++;

                    // Start a new table
                    available_height = total_num_rows;
                }
            }
        }

        // If the last table is partially filled, we need to add a complete new table
        if (available_height < total_num_rows) {
            widths_pack[offset] = flat_width[ordered_tables_air[i][num_tables_air - 1]];
        }

        VirtualTable(total_num_rows, ordered_tables_air[i], num_tables_air, total_height_air, vt_area[i],
                     uids_pack, tables_pack, widths_pack, lens_pack, num_packing_groups, i, best_cost,
                     flat_opid_idx, flat_table_idx, flat_table_id, flat_height, flat_width) alias `VirtualTable${AIRGROUP}${i}`;
    }
}

/**
 * Initializes the per-air registry of already materialized columns used by simplify_virtual_fixed.
 *
 * @param size Upper bound on the number of columns to simplify (one registry slot each).
 */
function init_simplify_virtual_fixed(const int size) {
    int air.signatures_count = 0;
    int air.signatures[size][2];
    expr air.signatures_fixed[size];
    if (DEBUG_MODE_PRINT) {
        string air.signatures_name[size];
    }
}

/**
 * Replaces a virtual (uncommitted) fixed column by the cheapest expression that reproduces its
 * contents: a constant, an offset of the row index, an already materialized column (optionally
 * rotated) or, as a last resort, a newly materialized fixed column.
 *
 * The contents are snapshotted here, so the caller can safely refill fixed_col afterwards.
 *
 * @param fixed_col The virtual column to simplify.
 * @param col_name  Name of the column if it ends up being materialized.
 * @return          An expression equivalent to fixed_col.
 */
function simplify_virtual_fixed(expr fixed_col, string col_name) : expr {
    const int aid = Tables.analyze(fixed_col);
    const int col_type = Tables.get_analyzed_type(aid);
    const int signature = Tables.get_analyzed_signature(aid);
    const int comparative_signature = Tables.get_analyzed_comparative_signature(aid);

    if (DEBUG_MODE_PRINT) {
        println(`[Debug] Virtual ${col_name} type ${col_type} signature ${signature} comparative_signature ${comparative_signature}`);
    }

    // Column type 1: constant column, we can prove it directly
    if (col_type == 1) {
        return Tables.get_value(fixed_col, 0);
    }

    // Column type 2: sequential column, i.e. a constant step between consecutive rows, so we can
    // express it as an affine combination of the row index: value_0 + delta·ROW_INDEX
    if (col_type == 2) {
        const int params[2] = Tables.get_analyzed_params(aid);   // [first_value, delta]
        const int value_0 = params[0];
        const int delta = params[1];
        const expr ROW_INDEX = get_ROW_INDEX();

        // The step is not necessarily 1, and it can also be negative
        expr linear_col = ROW_INDEX;
        if (delta != 1) {
            linear_col = delta * ROW_INDEX;
        }
        if (value_0 == 0) {
            return linear_col;
        }
        return linear_col + value_0;
    }

    // Search if exist a previous column compatible with this one (equals without or with offset)
    int index = 0;
    while (index < air.signatures_count) {
        if (air.signatures[index][0] == signature) {
            if (Tables.are_equals(air.signatures_fixed[index], 0, fixed_col, 0)) {
                if (DEBUG_MODE_PRINT) {
                    println(`[Debug] Found matching ${col_name} and ${air.signatures_name[index]}`);
                }
                return air.signatures_fixed[index];
            }
        }
        if (air.signatures[index][1] == comparative_signature) {
            int row_offset = Tables.compatible_offset(air.signatures_fixed[index], 0, fixed_col, 0);
            if (row_offset != -1) {
                // The match is fixed_col[i] == registered[(i + row_offset) mod N] + value_offset,
                // so the value offset is taken between row 0 of this column and row row_offset of
                // the registered one
                int reference_value = Tables.get_value(air.signatures_fixed[index], row_offset);
                int current_value = Tables.get_value(fixed_col, 0);
                int value_offset = current_value - reference_value;
                if (DEBUG_MODE_PRINT) {
                    println(`[Debug] Found matching ${col_name} and ${air.signatures_name[index]} with row_offset ${row_offset} value_offset ${value_offset}`);
                }
                if (value_offset == 0) {
                    return air.signatures_fixed[index]'(row_offset);
                }
                return air.signatures_fixed[index]'(row_offset) + value_offset;
            }
        }
        ++index;
    }

    // No candidate found, materialize the column and register it for the next ones
    col fixed air.`${col_name}`;
    expr final_col = air.`${col_name}`;
    Tables.copy(fixed_col, 0, final_col, 0, N);

    air.signatures[air.signatures_count][0] = signature;
    air.signatures[air.signatures_count][1] = comparative_signature;
    air.signatures_fixed[air.signatures_count] = final_col;
    if (DEBUG_MODE_PRINT) {
        air.signatures_name[air.signatures_count] = col_name;
    }
    ++air.signatures_count;

    return final_col;
}

airtemplate VirtualTable(const int N, const int tables[], const int num_tables, const int total_height, const int total_area,
                         const int uids[][], const int table_idxs[][], const int widths[], const int lens[],
                         const int num_groups, const int vt_idx, const int est_cost,
                         const int flat_opid_idx[], const int flat_table_idx[], const int flat_table_id[], const int flat_height[], const int flat_width[]) {
    // Compute the number of fixed and witness columns
    int sum_widths = 0;
    for (int i = 0; i < num_groups; i++) {
        sum_widths += widths[i];
    }

    // Virtual (uncommitted) columns: they are only used to build the contents, the columns that
    // actually reach the air are the ones decided by simplify_virtual_fixed. A single UID buffer
    // is enough since every group snapshots it before the next one refills it.
    col fixed virtual(N) tmp_UID;
    col fixed virtual(N) column[sum_widths];

    col witness multiplicity[num_groups];
    init_simplify_virtual_fixed(num_groups + sum_widths);

    // Issue hint information
    int flatten_table_ids[num_tables];
    int acc_heights[num_tables];
    int acc_total_height = 0;

    if (DEBUG_MODE_PRINT) {
        println(`[Debug] VirtualTable #${vt_idx} instantiated with: N=2^${log2(N)}, Tables=${num_tables}, Height=${total_height}, MaxWidth=${widths[num_groups-1]}, Splits=${num_groups}, Area=${total_area}, Cost=${est_cost}, #Fixed=${num_groups + sum_widths}, #Witness=${num_groups}`);
        println(`[Debug] Table composition:`);
    }
    for (int i = 0; i < num_tables; i++) {
        const int idx = tables[i];
        const int table_id = flat_table_id[idx];
        const int height = flat_height[idx];
        const int width = flat_width[idx];

        flatten_table_ids[i] = table_id;
        acc_heights[i] = acc_total_height;
        acc_total_height += height;

        if (DEBUG_MODE_PRINT) {
            println(`[Debug]    - Table ${table_id} with Height=${height}, Width=${width}, Area=${height*width}`);
        }
    }
    @virtual_table_data{table_ids: flatten_table_ids, acc_heights: acc_heights, num_muls: num_groups};

    // Prove the groups
    int col_offset = 0;
    int row_start = 0;
    for (int i = 0; i < num_groups; i++) {
        const int group_len = lens[i];
        const int group_width = widths[i];

        int group_row_offset = 0;
        for (int j = 0; j < group_len; j++) {
            const int idx = table_idxs[i][j];
            const int opid_idx = flat_opid_idx[idx];
            const int table_idx = flat_table_idx[idx];
            const int height = flat_height[idx];
            const int width = flat_width[idx];
            const int uid = uids[i][j];

            // Fill the UID column. Ensure the height does not exceed N
            const int height_remaining = height - row_start;
            const int N_remaining = N - group_row_offset;
            const int h = (height_remaining <= N_remaining) ? height_remaining : N_remaining;
            Tables.fill(uid, tmp_UID, group_row_offset, h);

            // Fill the table columns
            for (int l = 0; l < width; l++) {
                Tables.copy(vt.table_cols[opid_idx][table_idx][l], row_start, column[col_offset + l], group_row_offset, h);
            }

            // Update the row offset
            group_row_offset += h;

            // Update the row start
            if (height_remaining <= N_remaining) {
                row_start = 0;
            } else {
                row_start += h;
            }
        }

        // Since tmp_UID is shared by all the groups, the rows this group does not fill must be
        // cleared: otherwise they would keep the UID of the previous group, whose rows are already
        // padded with zeros in the table columns
        if (group_row_offset < N) {
            Tables.fill(0, tmp_UID, group_row_offset, N - group_row_offset);
        }

        int uids_to_prove[group_len];
        for (int j = 0; j < group_len; j++) {
            uids_to_prove[j] = uids[i][j];
        }

        expr cols_to_prove[group_width];
        for (int j = 0; j < group_width; j++) {
            cols_to_prove[j] = simplify_virtual_fixed(column[col_offset + j], `COL_${i}_${col_offset}_${j}`);
        }

        expr UID = simplify_virtual_fixed(tmp_UID, `UID_${i}`);

        // Perform the proving
        lookup_proves_dynamic(opids: uids_to_prove, busid: UID, expressions: cols_to_prove, mul: multiplicity[i]);

        // Update the column offset
        col_offset += group_width;
    }

    // save the airgroup id and air id of the table for latter use
    proof.std.vt.airgroup_ids[vt_idx] = AIRGROUP_ID;
    proof.std.vt.air_ids[vt_idx] = AIR_ID;

    on final proof issue_virtual_table_data_global();
}

private function issue_virtual_table_data_global() {
    use proof.std.vt;
    @virtual_table_data_global{airgroup_ids: airgroup_ids, air_ids: air_ids};
}