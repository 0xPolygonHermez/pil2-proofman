    // zMul stores all the powers of z (which is stored in challengeOut) up to nBits, i.e, [z, z^2, ..., z^nBits]
    signal zMul[{{ n_bits }}][3];
    for (var i = 0; i < {{ n_bits }}; i++) {
        if(i==0){
            zMul[i] <== CMul()(challengeOut, challengeOut);
        } else {
            zMul[i] <== CMul()(zMul[i-1], zMul[i-1]);
        }
    }

    // Store the vanishing polynomial Zh(x) = x^nBits - 1 evaluated at z
    signal Z[3] <== [zMul[{{ n_bits - 1 }}][0] - 1, zMul[{{ n_bits - 1 }}][1], zMul[{{ n_bits - 1 }}][2]];
    signal Zh[3] <== CInv()(Z);
{% for d in domains %}
    // Domain {{ d.k }}: V = prod_o (z^m - w^o); Zd = Z / V, or V when complemented
{% for f in d.factors %}{% if f.i == 0 %}    signal Zd{{ d.k }}V0[3] <== [{{ d.zm }}[0] - {{ f.root }}, {{ d.zm }}[1], {{ d.zm }}[2]];
{% else %}    signal Zd{{ d.k }}V{{ f.i }}[3] <== CMul()(Zd{{ d.k }}V{{ f.i - 1 }}, [{{ d.zm }}[0] - {{ f.root }}, {{ d.zm }}[1], {{ d.zm }}[2]]);
{% endif %}{% endfor %}{% if d.complement %}    signal Zd{{ d.k }}[3] <== Zd{{ d.k }}V{{ d.last }};
{% else %}    // V = 0 forces Z = 0, which CInv above already rejects.
    signal Zd{{ d.k }}[3] <== CDiv()(Z, Zd{{ d.k }}V{{ d.last }});
{% endif %}{% endfor %}
