pragma circom 2.1.0;
pragma custom_templates;

include "select_vk.circom";
include "agg_values.circom";
include "acc_points.circom";

{% for vf in verifier_filenames %}include "{{ vf }}";
{% endfor %}
template Recursive2() {
    var rootCBasics[{{ airs_in_group }}][4];

{{ rootc_basics }}
{{ vadcop_define_sv }}
{% if has_publics %}    signal input publics[{{ n_publics }}];
{% endif %}
{% if has_proof_values %}    signal input proofValues[{{ num_proof_values }}][3];
{% endif %}
    signal input globalChallenge[3];
    signal input rootCAgg[4];

{% for s in slots %}{{ s.vadcop_define }}
{{ s.stark_signals }}
{% endfor %}{{ agg_types_consistency }}
{% for s in slots %}{{ s.stark_assign }}
{% endfor %}{% for s in slots %}{{ s.vadcop_assign }}
{% endfor %}{% for s in slots %}    v{{ s.upper }}.rootC <== {{ sel_fn }}({{ airs_in_group }})({{ s.prefix }}_circuitType, rootCBasics, rootCAgg);
{% endfor %}
{{ agg_vadcop }}

    for (var i=0; i<4; i++) {
{% for s in slots %}        v{{ s.upper }}.publics[{{ n_publics_minus_4 }} + i] <== rootCAgg[i];
{% endfor %}    }
}

component main {public [{{ pub_names }}]} = Recursive2();
