pragma solidity ^0.8.20;

import {I{{ name }}Verifier} from "./I{{ name }}Verifier.sol";
import {{ "{" }}{{ snark }}Verifier} from "./{{ snark }}Verifier.sol";

/// @title {{ name }} Verifier
/// @author SilentSig
/// @notice This contracts implements a solidity verifier for {{ name }}.
contract {{ name }}Verifier is {{ snark }}Verifier, I{{ name }}Verifier {
    error InvalidProof();

    function VERSION() external pure returns (string memory) {
        return "v1.2.0-alpha";
    }

    /// @notice Root constant as bytes32 (pre-packed to match the original uint64[4] layout)
    function getRootCVadcopFinal() external pure returns (bytes32) {
        return bytes32(
            abi.encodePacked(
                uint64({{ root_c_0 }}),
                uint64({{ root_c_1 }}),
                uint64({{ root_c_2 }}),
                uint64({{ root_c_3 }})));
    }

    uint256 internal constant _RFIELD =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    /// @notice Hashes the public values into a field element inside BN254.
    function hashPublicValues(
        {% if has_program_vk %}bytes32 programVK,
        {% endif %}bytes32 rootCVadcopFinal,
        bytes calldata publicValues
    ) public pure returns (uint256) {
        return uint256(
            sha256(abi.encodePacked({% if has_program_vk %}{% if first_is_vk %}programVK, publicValues, rootCVadcopFinal{% else %}publicValues, programVK, rootCVadcopFinal{% endif %}{% else %}publicValues, rootCVadcopFinal{% endif %}))
        ) % _RFIELD;
    }

    /// @notice Verifies a proof with given public values and vkey.
    function verifySnarkProof(
        {% if has_program_vk %}bytes32 programVK,
        {% endif %}bytes32 rootCVadcopFinal,
        bytes calldata publicValues,
        bytes calldata proofBytes
    ) external view {
        uint256 publicValuesDigest = hashPublicValues({% if has_program_vk %}programVK, {% endif %}rootCVadcopFinal, publicValues);

        {{ proof_decode }}

        bool success = this.verifyProof(proofDecoded, [publicValuesDigest]);

        if (!success) {
            revert InvalidProof();
        }
    }
}
