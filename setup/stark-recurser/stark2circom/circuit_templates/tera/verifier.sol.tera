pragma solidity ^0.8.20;

import {I{{ name }}Verifier} from "./I{{ name }}Verifier.sol";
import {{ "{" }}{{ snark }}Verifier} from "./{{ snark }}Verifier.sol";

/// @title {{ name }} Verifier
/// @author SilentSig
/// @notice This contracts implements a solidity verifier for {{ name }}.
contract {{ name }}Verifier is {{ snark }}Verifier, I{{ name }}Verifier {
    /// @notice Thrown when the verifier selector from this proof does not match the one in this
    /// verifier. This indicates that this proof was sent to the wrong verifier.

    /// @notice Thrown when the proof is invalid.
    error InvalidProof();

    function VERSION() external pure returns (string memory) {
        return "v0.17.0";
    }

    function getRootCVadcopFinal() external pure returns (bytes32 memory) {
        return bytes32(abi.encodePacked(uint64({{ root_c_0 }}), uint64({{ root_c_1 }}), uint64({{ root_c_2 }}), uint64({{ root_c_3 }})));
    }

    // Modulus zkSNARK
    uint256 internal constant _RFIELD =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;

    /// @notice Hashes the public values to a field elements inside Bn254.
    /// @param publicValues The public values.
    function hashPublicValues(
        {% if has_program_vk %}bytes32 calldata programVK, {% endif %}bytes32 calldata rootCVadcopFinal,
        bytes calldata publicValues
    ) public pure returns (uint256) {
        {% if has_program_vk %}{% if first_is_vk %}return uint256(sha256(abi.encodePacked(programVK, publicValues, rootCVadcopFinal))) % _RFIELD;
        {% else %}return uint256(sha256(abi.encodePacked(publicValues, programVK, rootCVadcopFinal))) % _RFIELD;
        {% endif %}{% else %}return uint256(sha256(abi.encodePacked(publicValues, rootCVadcopFinal))) % _RFIELD;
        {% endif %}    }

    /// @notice Verifies a proof with given public values and vkey.
    {% if has_program_vk %}/// @param programVK The verification key for the RISC-V program.
    {% endif %}/// @param rootCVadcopFinal The rootC value for the Vadcop final.
    /// @param publicValues The public values encoded as bytes.
    /// @param proofBytes The proof of the program execution the {{ name }} zkVM encoded as bytes.
    function verifySnarkProof(
        {% if has_program_vk %}bytes32 calldata programVK, {% endif %}bytes32 calldata rootCVadcopFinal,
        bytes calldata publicValues,
        bytes calldata proofBytes
    ) external view {
        uint256 publicValuesDigest = hashPublicValues({% if has_program_vk %}programVK, {% endif %}rootCVadcopFinal, publicValues);

        {{ proof_decode }}

        bool success = this.verifyProof(proofDecoded,[publicValuesDigest]);

        if (!success) {
            revert InvalidProof();
        }
    }
}
