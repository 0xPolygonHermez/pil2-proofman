pragma circom 2.1.0;
pragma custom_templates;

include "iszero.circom";
include "agg_values.circom";
include "acc_points.circom";
{% for vf in verifier_filenames %}include "{{ vf }}";
{% endfor %}{% if not has_compressor %}include "elliptic_curve.circom";

{{ calculate_hashes }}
{% endif %}
template Recursive1() {

{{ vadcop_define_sv }}
{% if has_publics %}    signal input publics[{{ n_publics }}];
{% endif %}
{% if has_proof_values %}    signal input proofValues[{{ num_proof_values }}][3];
{% endif %}
    signal input globalChallenge[3];

    signal input rootCAgg[4];

{% for s in slots %}{{ s.vadcop_define }}
{{ s.stark_signals }}
{% endfor %}{% if not has_compressor %}    // 1 = empty slot, dropped from the fold and the count.
{% for s in slots %}    signal input {{ s.lower }}_isNull;
{% endfor %}
{% for s in slots %}    {{ s.lower }}_isNull * ({{ s.lower }}_isNull - 1) === 0;
{% endfor %}{% endif %}
{% for s in slots %}{{ s.stark_assign }}
{% endfor %}{% for s in slots %}{{ s.vadcop_assign }}
{% endfor %}
{{ agg_types_consistency }}

{{ agg_vadcop }}

    // An all-empty batch would prove nothing, and vadcop_final drops the count that shows it.
    signal {binary} noProofs <== IsZero()(sv_aggregatedProofs);
    noProofs === 0;

    // The air's own type: the aggregated one would make recursive2 select rootCAgg.
    sv_circuitType <== {{ circuit_type }};
}

component main {public [{{ pub_names }}]} = Recursive1();
