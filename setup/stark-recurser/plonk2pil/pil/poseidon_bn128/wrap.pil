require "std_constants.pil";
require "std_connection.pil";

require "circuits/plonk.pil";
require "circuits/poseidon_bn128.pil";
require "circuits/num2bytes.pil";

// ============================================================================
// PoseidonBN128 WRAP
//
// The AIR of the final SNARK wrap, over BN128, proved with pilfflonk: the circom verifier of the
// last STARK (`final.circom`, with custom templates) as PLONK gates and the custom gates
// `PoseidonT(5)` and `Num2Bytes(nBits)`. Layout L1, with range checks:
//
//   - 3 PLONK gates a row, gate g on a[3g..3g+2], all three with the row's one coefficient set C;
//   - a PoseidonT(5) use is a band of 69 rows, one round a row on a[0..4]: row r holds the state
//     before round r (the gate's `in` on row 0, `im[r - 1]` after), row 68 its `out`. PLONK gates 0
//     and 1 are off in the band, whose lanes they would read; gate 2 stays on, on a[6..8];
//   - a Num2Bytes(nBits) use is a row: its `in` on a[0], its ⌈nBits/16⌉ chunks of 16 bits from
//     a[1], zeros up to a[5] (circuits/num2bytes.pil). PLONK gates 0 and 1 are off, gate 2 on;
//   - the std's connection over every wire, a[0..8], on the product bus, and the range checks'
//     lookup of every chunk cell into the table RANGE, on the sum bus;
//   - the publics, each bound to a cell of the rows that follow the gates.
//
//   rows                 | a[0..4]                         | a[5]  | a[6..8]      | selectors
//   ---------------------+---------------------------------+-------+--------------+-------------------------
//   band row r, r < 68   | the state before r              | -     | PLONK gate 2 | POSEIDON, FULL or PARTIAL
//   band row 68          | out                             | -     | PLONK gate 2 | POSEIDON
//   range-check rows     | in, then the chunks and zeros (a[0..5]) | PLONK gate 2 | RANGE_CHECK
//   PLONK rows           | PLONK gates 0 and 1 (a[0..5])           | PLONK gate 2 |
//   public rows          | the publics, 9 a row                                   | PUBLICS_ROW[k] on the k-th
//
// The row's constants K are a band row's round constants, and a range-check row's chunk weights:
// no round reads them there. RANGE, the range checks' table, holds `i mod 2^16` on row i, and
// RANGE_MUL how many times the chunk cells look up its row i < 2^16 (0 on the rows after), which
// the wrap's witness counts. With no Num2Bytes use (nRangeChecks = 0), the AIR has none of the
// three, nor the sum bus.
//
// Every fixed column but the std's own (the connection's ID and __L1__) is computed by plonk2pil
// and given to the setup, `#pragma fixed_external`, instead of being written into the pilout: a
// pilout holds at most 2 GiB, which the fixed columns of a wrap of 2^22 rows (a final circuit
// without range checks) exceed, and plonk2pil has their values already. A row without a PLONK
// constraint has C = 0, so its gates hold whatever the row's cells.
// ============================================================================
airtemplate Wrap (const int N, const int nPublics, const int nRangeChecks) {
    const int nWires = 9;

    // The std's buses: the connection's, a product, and the range checks' lookup, a sum.
    const int CONNECTION_OPID = 1;
    const int RANGE_CHECK_OPID = 2;

    col witness a[nWires];

    #pragma fixed_external
    col fixed S[nWires];

    // [qM, qL, qR, qO, qC] of the row's gates.
    #pragma fixed_external
    col fixed C[5];

    // The row's constants: on band row r, the round constants C[5·r + j] of POSEIDON_C_ORIGINAL(5);
    // on a range-check row of n chunks, the chunk weights, 2^(16·k) for k < n and 0 for k >= n.
    #pragma fixed_external
    col fixed K[POSEIDON_BN128_WIDTH];

    // 1 on every row of a band; 1 on the rows of a full round, and of a partial round.
    #pragma fixed_external
    col fixed POSEIDON;
    #pragma fixed_external
    col fixed POSEIDON_FULL_ROUND;
    #pragma fixed_external
    col fixed POSEIDON_PARTIAL_ROUND;

    // The rows PLONK gates 0 and 1 are off on: a band's and a range check's.
    expr customGateRow = POSEIDON;
    if (nRangeChecks > 0) {
        if (N < 2**NUM2BYTES_CHUNK_BITS) {
            error(`the range checks' table needs N >= 2^${NUM2BYTES_CHUNK_BITS}, and N = ${N}`);
        }
        // 1 on every range-check row.
        #pragma fixed_external
        col fixed RANGE_CHECK;
        // i mod 2^16 on row i.
        #pragma fixed_external
        col fixed RANGE;
        col witness RANGE_MUL;

        const expr chunks[NUM2BYTES_CHUNKS];
        for (int k = 0; k < NUM2BYTES_CHUNKS; k++) {
            chunks[k] = a[1 + k];
        }
        num2bytes(RANGE_CHECK_OPID, a[0], chunks, K, RANGE_CHECK, RANGE, RANGE_MUL);
        customGateRow = POSEIDON + RANGE_CHECK;
    }

    // The publics, 9 a row from the first public row: public i is a[i % 9] of public row i / 9,
    // where PUBLICS_ROW[i / 9] is 1. A selector for each public row, rather than one selector read
    // i / 9 rows back, keeps every fixed column opened at the row alone: an opening at another
    // offset is a group of its own, which the setup cannot always place. One public row has a
    // column, not an array of one.
    if (nPublics > 0) {
        const int nPublicRows = (nPublics + nWires - 1) / nWires;
        const expr publicsRow[nPublicRows];
        if (nPublicRows == 1) {
            #pragma fixed_external
            col fixed PUBLICS_ROW;
            publicsRow[0] = PUBLICS_ROW;
        } else {
            #pragma fixed_external
            col fixed PUBLICS_ROW[nPublicRows];
            for (int k = 0; k < nPublicRows; k++) {
                publicsRow[k] = PUBLICS_ROW[k];
            }
        }
        for (int i = 0; i < nPublics; i++) {
            publicsRow[i / nWires] * (a[i % nWires] - publics[i]) === 0;
        }
    }

    const expr q[5] = [C[0], C[1], C[2], C[3], C[4]];
    plonk([a[0], a[1], a[2]], q, 1 - customGateRow);
    plonk([a[3], a[4], a[5]], q, 1 - customGateRow);
    plonk([a[6], a[7], a[8]], q, 1);

    const expr state[POSEIDON_BN128_WIDTH];
    const expr next[POSEIDON_BN128_WIDTH];
    const expr rc[POSEIDON_BN128_WIDTH];
    for (int j = 0; j < POSEIDON_BN128_WIDTH; j++) {
        state[j] = a[j];
        next[j] = a[j]';
        rc[j] = K[j];
    }
    poseidonBn128Round(state, next, rc, POSEIDON_FULL_ROUND, POSEIDON_PARTIAL_ROUND);

    const expr wires[nWires];
    for (int i = 0; i < nWires; i++) {
        wires[i] = a[i];
    }
    connection(CONNECTION_OPID, wires, S, PIOP_BUS_PROD);
}
