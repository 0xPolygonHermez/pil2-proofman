require "std_constants.pil";
require "std_connection.pil";

require "circuits/cmul.pil";
require "circuits/fft.pil";
require "circuits/evpol.pil";
require "circuits/treeselector.pil";
require "circuits/selectval.pil";
require "circuits/poseidon.pil";
require "circuits/plonk.pil";

airtemplate Aggregator (const int N, const int nPlonkRows, const int nPoseidon1Compression, const int nPoseidon1Sponge, const int nCMulRows, const int nEvPol4, const int nFFT4, const int nTreeSelector8, const int nSelectVal1) {
    col witness a[62];

    #pragma fixed_external
    col fixed S[30];

    #pragma fixed_external
    col fixed C[10];

    const int nPoseidon1 = nPoseidon1Compression + nPoseidon1Sponge;
    const int nPoseidonRows = 5 * nPoseidon1;

    // Three Poseidon1 fixed cols — all inner row positions derived via primes.
    //   COMPRESSION fires at row 0 of each CustPoseidon1 (Davies-Meyer) gate.
    //   SPONGE      fires at row 0 of each regular Poseidon1 gate.
    //   FINAL       fires at row 4 of every Poseidon1 gate.
    col fixed POSEIDON1_COMPRESSION = [[1,0:4]:nPoseidon1Compression, [0:5]:nPoseidon1Sponge, 0...];
    col fixed POSEIDON1_SPONGE      = [[0:5]:nPoseidon1Compression, [1,0:4]:nPoseidon1Sponge, 0...];
    col fixed POSEIDON1_FINAL       = [[0:4,1]:nPoseidon1Compression, [0:4,1]:nPoseidon1Sponge, 0...];

    col fixed CMUL          = [0:nPoseidonRows,                                                                       1:nCMulRows,   0...];
    col fixed EVPOL4        = [0:(nPoseidonRows + nCMulRows),                                                         1:nEvPol4,     0...];
    col fixed FFT4          = [0:(nPoseidonRows + nCMulRows + nEvPol4),                                               1:nFFT4,       0...];
    col fixed TREESELECTOR8 = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4),                                       1:nTreeSelector8, 0...];
    col fixed SELECTVAL1    = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector8),                      1:nSelectVal1, 0...];
    col fixed PLONK         = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector8 + nSelectVal1),        1:nPlonkRows,  0...];

    const expr q0[5] = [C[0], C[1], C[2], C[3], C[4]];
    const expr q1[5] = [C[5], C[6], C[7], C[8], C[9]];

    // Derived row selectors via primes.
    //   INIT          (row 0) = COMPRESSION + SPONGE
    //   PR_PRIME      (row 1) = 'INIT             (chain-2 round-3 P-matrix fires here)
    //   PR            (row 2) = (2)'INIT          (R4 storage row + single 22-round partial chain)
    //   FINAL_PRIME   (row 3) = POSEIDON1_FINAL'
    const expr POSEIDON1_INIT        = POSEIDON1_COMPRESSION + POSEIDON1_SPONGE;
    const expr POSEIDON1_PR_PRIME    = 'POSEIDON1_COMPRESSION + 'POSEIDON1_SPONGE;
    const expr POSEIDON1_PR          = (2)'POSEIDON1_COMPRESSION + (2)'POSEIDON1_SPONGE;
    const expr POSEIDON1_FINAL_PRIME = POSEIDON1_FINAL';

    // Plonk piggybacks on PR' (row 1), PR (row 2), and FINAL' (row 3) — chain slots
    // there hold R-values or anchors, while plonk-band cols 0..29 are free at each
    // of those rows. With anchors moved out of row-0 cols 18..23 (chain-1-anchors
    // variant), INIT row also exposes gates 6, 7, 8, 9 (four-tier) just like FINAL.
    const expr CHECK_PLONK = PLONK + POSEIDON1_PR_PRIME + POSEIDON1_PR + POSEIDON1_FINAL_PRIME;

    plonk([a[0], a[1], a[2]], q0, CHECK_PLONK);
    plonk([a[3], a[4], a[5]], q0, CHECK_PLONK);
    plonk([a[6], a[7], a[8]], q1, CHECK_PLONK);
    plonk([a[9], a[10], a[11]], q1, CHECK_PLONK);
    plonk([a[12], a[13], a[14]], q1, CHECK_PLONK);
    plonk([a[15], a[16], a[17]], q1, CHECK_PLONK);
    plonk([a[18], a[19], a[20]], q1, CHECK_PLONK + POSEIDON1_FINAL + POSEIDON1_INIT);
    plonk([a[21], a[22], a[23]], q1, CHECK_PLONK + POSEIDON1_FINAL + POSEIDON1_INIT + EVPOL4);
    plonk([a[24], a[25], a[26]], q1, CHECK_PLONK + POSEIDON1_FINAL + POSEIDON1_INIT + EVPOL4 + SELECTVAL1);
    plonk([a[27], a[28], a[29]], q1, CHECK_PLONK + POSEIDON1_FINAL + POSEIDON1_INIT + EVPOL4 + SELECTVAL1);

    // ── Poseidon1 (Hades-Goldilocks, width 16) — 5-row layout per gate ───────────
    // chain-1-anchors variant: R4 is NOT stored. The 22 partial-chain anchors live
    // split across both chain slots at PR (row 2). No overflow into the plonk band.
    //
    //   Row 0 (INIT=1):   a[0..15]=input                              a[30..45]=input(dup, R0)  a[46..61]=R1
    //   Row 1 (PR'=1):                                                a[30..45]=R2              a[46..61]=R3
    //   Row 2 (PR=1):                                                 a[30..40]=anchors[0..10]  a[46..56]=anchors[11..21]
    //                                                                 (a[41..45] and a[57..61] unused; chain 1/2 main pow7 polys evaluated but result discarded there)
    //   Row 3 (FINAL'=1):                                             a[30..45]=R26             a[46..61]=R27
    //   Row 4 (FINAL=1):  a[0..15]=output                             a[30..45]=R28             a[46..61]=R29
    //
    // Chain 1 fires (M-matrix) at rounds 0, 2, 26, 28 → rows {0, 1, 3, 4}.
    // Chain 2 fires (M-matrix) at rounds 1, 27, 29     → rows {0, 3, 4}.
    // Chain 2 fires (P-matrix) at round 3              → row 1 (output R4 is not stored;
    //   it's the input to the partial chain via prefix prime of fullRound2P).
    // Single 22-round partial chain fires at PR=row 2 with anchors split 11+11 between
    // chain 1 slot (a[30..40]) and chain 2 slot (a[46..56]).
    //
    // SBOX-sharing — pow7Shared (chain-1 main) and pow7Shared2 (chain-2 main) both
    // double as anchor pow7 at PR row:
    //   pow7Shared[r] at PR  = pow7(a[r+30]) = pow7(anchor[r]) for r=0..10.
    //   pow7Shared2[r] at PR = pow7(a[r+46]) = pow7(anchor[11+r]) for r=0..10.
    // No overflow pow7 bank needed → 32 distinct pow7 polys total (16 + 16).
    //
    // Partial chain input is the degree-7 P-matrix expression 'fullRound2P[i] read
    // from PR' row. Anchor checks come out at degree 8 (selector × deg-7 state).
    //
    // ARC convention (Hades): RC added BEFORE pow7 only at round 0 (pre-ARC, chain 1).
    // All other rounds add post-ARC OUTSIDE pow7.
    //
    // Davies-Meyer: at FINAL row 4, output += input only when COMPRESSION fired at INIT.

    const expr pow7Input1[POSEIDON_WIDTH_GL];
    const expr pow7Input2[POSEIDON_WIDTH_GL];
    const expr pow7Shared[POSEIDON_WIDTH_GL];
    const expr pow7Shared2[POSEIDON_WIDTH_GL];

    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        // Chain 1: INIT pre-ARC (round 0 only) folded inside pow7 input.
        pow7Input1[i] = a[i + 30] + POSEIDON1_INIT * POSEIDON_C_GL[i];
        pow7Input2[i] = a[i + 46];
    }
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        pow7Shared[i]  = pow7(pow7Input1[i]);
        pow7Shared2[i] = pow7(pow7Input2[i]);
    }

    // Per-round post-S-box ARC (Hades: added OUTSIDE pow7).
    const expr ARC1[POSEIDON_WIDTH_GL];
    const expr ARC2[POSEIDON_WIDTH_GL];
    const expr preMat1[POSEIDON_WIDTH_GL];
    const expr preMat2[POSEIDON_WIDTH_GL];
    const expr outputF1[POSEIDON_WIDTH_GL];
    const expr outputF2[POSEIDON_WIDTH_GL];

    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        // Chain 1 rounds: 0 (INIT), 2 (PR'), 26 (FINAL'), 28 (FINAL).
        ARC1[i] = POSEIDON1_INIT        * POSEIDON_C_GL[i + 16]    // round 0
                + POSEIDON1_PR_PRIME    * POSEIDON_C_GL[i + 48]    // round 2
                + POSEIDON1_FINAL_PRIME * POSEIDON_C_GL[i + 102]   // round 26
                + POSEIDON1_FINAL       * POSEIDON_C_GL[i + 134];  // round 28

        // Chain 2 rounds: 1 (INIT), 3 (PR' — P-matrix), 27 (FINAL'); round 29 (FINAL) has no ARC.
        ARC2[i] = POSEIDON1_INIT        * POSEIDON_C_GL[i + 32]    // round 1
                + POSEIDON1_PR_PRIME    * POSEIDON_C_GL[i + 64]    // round 3 (P-matrix)
                + POSEIDON1_FINAL_PRIME * POSEIDON_C_GL[i + 118];  // round 27

        preMat1[i] = pow7Shared[i]  + ARC1[i];
        preMat2[i] = pow7Shared2[i] + ARC2[i];

        outputF1[i] = a[i + 46];   // chain 1 output → same-row a[46..61]

        // Chain 2 output:
        //   INIT / FINAL' → next-row chain 1 slot (R2 at row 1, R28 at row 4).
        //   FINAL          → same-row a[0..15] (output cells), DM-summed if COMPRESSION.
        //   PR' excluded — uses P-matrix; result is consumed directly by the partial
        //   chain via prefix prime 'fullRound2P (R4 not stored as witness).
        outputF2[i] = (POSEIDON1_INIT + POSEIDON1_FINAL_PRIME) * a[i + 30]'
                    + POSEIDON1_FINAL * (a[i] - (4)'POSEIDON1_COMPRESSION * (4)'a[i]);
    }

    // INIT input-ordering: R0 (= a[i+30] @ INIT) === permuted(input, key) for CustPoseidon1
    // (Davies-Meyer compression mode), or R0 === input for plain Poseidon1 (sponge mode).
    // Key bits live at a[16], a[17] @ INIT row; the helper also enforces their binary check.
    const expr inputCells[POSEIDON_WIDTH_GL];
    const expr R0Cells[POSEIDON_WIDTH_GL];
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        inputCells[i] = a[i];
        R0Cells[i]    = a[i + 30];
    }
    const expr poseidon1Key[2] = [a[16], a[17]];
    poseidon1InputOrderGl(inputCells, poseidon1Key, R0Cells, POSEIDON1_COMPRESSION, POSEIDON1_SPONGE);

    const expr fullRound1[POSEIDON_WIDTH_GL] = poseidonFullRoundGl(preMat1);
    poseidonFullRoundCheckGl(fullRound1, outputF1, POSEIDON1_INIT + POSEIDON1_PR_PRIME + POSEIDON1_FINAL_PRIME + POSEIDON1_FINAL);

    const expr fullRound2[POSEIDON_WIDTH_GL] = poseidonFullRoundGl(preMat2);
    poseidonFullRoundCheckGl(fullRound2, outputF2, POSEIDON1_INIT + POSEIDON1_FINAL_PRIME + POSEIDON1_FINAL);

    // ── Round 3 → R4 (P-matrix transition, not stored) ──────────────────────────
    // fullRound2P[i] evaluated at row 1 (PR' row, R3 in chain-2 slot) = P × (pow7(R3) + C[i+64]).
    // R4 is NOT stored; the partial chain reads its input via prefix prime 'fullRound2P
    // (degree-7 expression). The first anchor check enforces consistency, so no separate
    // R4 equality is needed.
    const expr fullRound2P[POSEIDON_WIDTH_GL] = poseidonPmatrixGl(preMat2);

    // ── Single 22-round partial chain firing at PR (row 2) ──────────────────────
    // Anchors split 11+11 across both chain slots of PR:
    //   anchors[0..10]  at row 2 chain 1 slot (a[30..40], 11 cells; a[41..45] unused)
    //   anchors[11..21] at row 2 chain 2 slot (a[46..56], 11 cells; a[57..61] unused)
    // Chain input  = 'fullRound2P[i] (degree-7 P-matrix expression from PR' row).
    // Chain output = R26 at row 3 chain 1 (postfix prime from row 2).
    const expr st0Gl[22];
    const expr intermediateValuesGl[22];

    for (int r = 0; r < 11; r++) {
        st0Gl[r] = a[r + 30];                                                        // row 2 chain 1 slot (h1)
        intermediateValuesGl[r] = pow7Shared[r] + POSEIDON_C_GL[80 + r];             // share pow7Shared (chain 1 main)
    }
    for (int r = 0; r < 11; r++) {
        st0Gl[11 + r] = a[r + 46];                                                   // row 2 chain 2 slot (h2)
        intermediateValuesGl[11 + r] = pow7Shared2[r] + POSEIDON_C_GL[91 + r];       // share pow7Shared2 (chain 2 main)
    }

    const expr inputPGl[POSEIDON_WIDTH_GL];
    const expr outputPGl[POSEIDON_WIDTH_GL];
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        inputPGl[i]  = 'fullRound2P[i];  // R4 expression (degree 7, computed at PR' row)
        outputPGl[i] = a[i + 30]';       // R26 at row 3 chain 1 (next row)
    }

    const expr partialChainGl[22 + POSEIDON_WIDTH_GL] = poseidonPartialChainGl(22, 0, inputPGl, intermediateValuesGl);

    for (int r = 0; r < 22; r++) {
        POSEIDON1_PR * (st0Gl[r] - partialChainGl[r]) === 0;
    }
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        POSEIDON1_PR * (outputPGl[i] - partialChainGl[22 + i]) === 0;
    }

    // ── Remaining custom-gate circuits ──────────────────────────────────────────
    const expr inA1[3] = [a[0], a[1], a[2]];
    const expr inB1[3] = [a[3], a[4], a[5]];
    const expr res[3] = [a[6], a[7], a[8]];
    cmul(inA1, inB1, res, CMUL);

    const expr inA2[3] = [a[9], a[10], a[11]];
    const expr inB2[3] = [a[12], a[13], a[14]];
    const expr res2[3] = [a[15], a[16], a[17]];
    cmul(inA2, inB2, res2, CMUL);

    const expr inA3[3] = [a[18], a[19], a[20]];
    const expr inB3[3] = [a[21], a[22], a[23]];
    const expr res3[3] = [a[24], a[25], a[26]];
    cmul(inA3, inB3, res3, CMUL);

    const expr inpFFT[12] = [a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11]];
    const expr outFFT[12] = [a[12], a[13], a[14], a[15], a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23]];
    const expr constFFT[9] = [C[0], C[1], C[2], C[3], C[4], C[5], C[6], C[7], C[8]];
    fft4(inpFFT, constFFT, outFFT, FFT4);

    const expr coefs[5][3];
    coefs[0] = [a[12], a[13], a[14]];
    coefs[1] = [a[9], a[10], a[11]];
    coefs[2] = [a[6], a[7], a[8]];
    coefs[3] = [a[3], a[4], a[5]];
    coefs[4] = [a[0], a[1], a[2]];
    const expr x[3] = [a[15], a[16], a[17]];
    const expr resEVPOL[3] = [a[18], a[19], a[20]];
    evpol4(coefs, x, resEVPOL, EVPOL4);

    const expr treevals[8][3];
    treevals[0] = [a[0],  a[1],  a[2]];
    treevals[1] = [a[3],  a[4],  a[5]];
    treevals[2] = [a[6],  a[7],  a[8]];
    treevals[3] = [a[9],  a[10], a[11]];
    treevals[4] = [a[12], a[13], a[14]];
    treevals[5] = [a[15], a[16], a[17]];
    treevals[6] = [a[18], a[19], a[20]];
    treevals[7] = [a[21], a[22], a[23]];
    const expr key[3] = [a[24], a[25], a[26]];
    const expr resTREE[3] = [a[27], a[28], a[29]];
    treeselector8(treevals, key, resTREE, TREESELECTOR8);

    const expr selectvals[4][4];
    selectvals[0] = [a[0], a[1], a[2], a[3]];
    selectvals[1] = [a[4], a[5], a[6], a[7]];
    selectvals[2] = [a[8], a[9], a[10], a[11]];
    selectvals[3] = [a[12], a[13], a[14], a[15]];
    const expr selectvals_key[2] = [a[16], a[17]];
    const expr selected[4] = [a[18], a[19], a[20], a[21]];
    selectval1(selectvals, selectvals_key, selected, SELECTVAL1);

    const expr A[30];
    for (int i = 0; i < 30; i++) {
        A[i] = a[i];
    }
    connection(1, A, S, PIOP_BUS_PROD);
}
