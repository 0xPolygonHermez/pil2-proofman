require "std_constants.pil";
require "std_connection.pil";

require "circuits/cmul.pil";
require "circuits/fft.pil";
require "circuits/evpol.pil";
require "circuits/treeselector.pil";
require "circuits/selectval.pil";
require "circuits/poseidon.pil";
require "circuits/plonk.pil";

airtemplate Compressor (const int N, const int nPlonkRows, const int nPoseidon1Compression, const int nPoseidon1Sponge, const int nCMulRows, const int nEvPol4, const int nFFT4, const int nTreeSelector8, const int nSelectVal1) {
    col witness a[52];

    #pragma fixed_external
    col fixed S[36];

    #pragma fixed_external
    col fixed C[10];

    const int nPoseidon1 = nPoseidon1Compression + nPoseidon1Sponge;
    const int nPoseidonRows = 9 * nPoseidon1;

    // Three Poseidon1 fixed cols — all inner row positions derived via primes.
    //   COMPRESSION fires at row 0 of each CustPoseidon1 (Davies-Meyer) gate.
    //   SPONGE      fires at row 0 of each regular Poseidon1 gate.
    //   FINAL       fires at row 8 of every Poseidon1 gate.
    col fixed POSEIDON1_COMPRESSION = [[1,0:8]:nPoseidon1Compression, [0:9]:nPoseidon1Sponge, 0...];
    col fixed POSEIDON1_SPONGE      = [[0:9]:nPoseidon1Compression, [1,0:8]:nPoseidon1Sponge, 0...];
    col fixed POSEIDON1_FINAL       = [[0:8,1]:nPoseidon1Compression, [0:8,1]:nPoseidon1Sponge, 0...];

    // Row selectors via primes.
    // Prefix `'X` shifts BACKWARD (X at row r-1); postfix `X'` shifts FORWARD.
    //   R0..PR look back from rows 0..4 to where INIT fires (row 0).
    //   R26..R29 look forward from rows 5..8 to where FINAL fires (row 8).
    // R4 is NOT stored as a witness — the partial chain reads its input via prefix
    // prime of fullRoundP (the round-3 P-matrix expression evaluated at PR' row).
    const expr POSEIDON1_INIT     = POSEIDON1_COMPRESSION + POSEIDON1_SPONGE;
    const expr POSEIDON1_R0       = POSEIDON1_INIT;                  // row 0
    const expr POSEIDON1_R1       = 'POSEIDON1_INIT;                 // row 1
    const expr POSEIDON1_R2       = (2)'POSEIDON1_INIT;              // row 2
    const expr POSEIDON1_PR_PRIME = (3)'POSEIDON1_INIT;              // row 3 (R3 row, round-3 P-matrix)
    const expr POSEIDON1_PR       = (4)'POSEIDON1_INIT;              // row 4 (single 22-round partial chain)
    const expr POSEIDON1_R26      = POSEIDON1_FINAL'(3);             // row 5
    const expr POSEIDON1_R27      = POSEIDON1_FINAL'(2);             // row 6
    const expr POSEIDON1_R28      = POSEIDON1_FINAL';                // row 7
    const expr POSEIDON1_R29      = POSEIDON1_FINAL;                 // row 8

    col fixed CMUL          = [0:nPoseidonRows,                                                                       1:nCMulRows,   0...];
    col fixed EVPOL4        = [0:(nPoseidonRows + nCMulRows),                                                         1:nEvPol4,     0...];
    col fixed FFT4          = [0:(nPoseidonRows + nCMulRows + nEvPol4),                                               1:nFFT4,       0...];
    col fixed TREESELECTOR8 = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4),                                       1:nTreeSelector8, 0...];
    col fixed SELECTVAL1    = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector8),                      1:nSelectVal1, 0...];
    col fixed PLONK         = [0:(nPoseidonRows + nCMulRows + nEvPol4 + nFFT4 + nTreeSelector8 + nSelectVal1),        1:nPlonkRows,  0...];

    const expr q0[5] = [C[0], C[1], C[2], C[3], C[4]];
    const expr q1[5] = [C[5], C[6], C[7], C[8], C[9]];

    // Plonk piggybacks on every Poseidon row except INIT and FINAL (which host
    // input/output on cols 0..15 + selector-piggybacked plonk gates on cols 24..35).
    // PR row's chain slot holds anchors but its plonk-band cols 0..35 are fully free
    // (with key bits relocated to INIT row cols 16..17), so PR joins CHECK_PLONK.
    const expr CHECK_PLONK = PLONK
        + POSEIDON1_R1 + POSEIDON1_R2 + POSEIDON1_PR_PRIME
        + POSEIDON1_PR
        + POSEIDON1_R26 + POSEIDON1_R27 + POSEIDON1_R28;

    plonk([a[0], a[1], a[2]], q0, CHECK_PLONK);
    plonk([a[3], a[4], a[5]], q0, CHECK_PLONK);
    plonk([a[6], a[7], a[8]], q0, CHECK_PLONK);
    plonk([a[9], a[10], a[11]], q0, CHECK_PLONK);
    plonk([a[12], a[13], a[14]], q0, CHECK_PLONK);
    plonk([a[15], a[16], a[17]], q0, CHECK_PLONK);
    plonk([a[18], a[19], a[20]], q1, CHECK_PLONK + POSEIDON1_FINAL);
    plonk([a[21], a[22], a[23]], q1, CHECK_PLONK + POSEIDON1_FINAL + EVPOL4);
    plonk([a[24], a[25], a[26]], q1, CHECK_PLONK + POSEIDON1_FINAL + EVPOL4 + SELECTVAL1 + POSEIDON1_INIT);
    plonk([a[27], a[28], a[29]], q1, CHECK_PLONK + POSEIDON1_FINAL + EVPOL4 + SELECTVAL1 + POSEIDON1_INIT);
    plonk([a[30], a[31], a[32]], q1, CHECK_PLONK + POSEIDON1_FINAL + EVPOL4 + SELECTVAL1 + POSEIDON1_INIT);
    plonk([a[33], a[34], a[35]], q1, CHECK_PLONK + POSEIDON1_FINAL + EVPOL4 + SELECTVAL1 + POSEIDON1_INIT);

    const int firstColP = 36;

    // ── Poseidon1 (Hades-Goldilocks, width 16) — 9-row layout per gate ──────────
    // One chain slot per row at cols 36..51. State is read uniformly from a[i+firstColP].
    // R4 is NOT stored — the partial chain reads its input via prefix prime of
    // fullRoundP (round-3 P-matrix expression evaluated at PR' row). State expressions
    // inside the partial chain stay at degree 7 → anchor checks at degree 8, fits max=8.
    //
    //   Row 0 (INIT/R0):   a[0..15]=input  a[18..23]=im[16..21]   a[36..51]=input(dup, R0)
    //   Row 1 (R1):                                                a[36..51]=R1
    //   Row 2 (R2):                                                a[36..51]=R2
    //   Row 3 (R3, PR'):                                           a[36..51]=R3
    //                       (round-3 P-matrix on R3: pow7(R3) + C[round 3] → P → R4 expression)
    //   Row 4 (PR):                                                a[36..51]=im[0..15]  (anchors fully fill chain slot)
    //                       (single 22-round partial chain: reads 'fullRoundP (R4 expression),
    //                        outputs R26 to row 5's chain slot)
    //   Row 5 (R26):                                                a[36..51]=R26
    //   Row 6 (R27):                                                a[36..51]=R27
    //   Row 7 (R28):                                                a[36..51]=R28
    //   Row 8 (R29, FINAL):a[0..15]=output                          a[36..51]=R29
    //
    // SBOX-sharing: at row 4 the main chain doesn't fire, so a[i+firstColP] there
    // holds anchors. pow7Shared[r] at row 4 = pow7(anchor[r]) for r=0..15. The 6
    // overflow anchors at row 0 cols 18..23 need 6 separate pow7 expressions.
    //
    // ARC convention (Hades): RC added BEFORE pow7 only at round 0 (INIT pre-ARC).
    // All other rounds add their post-ARC OUTSIDE pow7.
    //
    // Davies-Meyer: at FINAL row 8, output += input only when COMPRESSION fired at INIT.
    // (8)'POSEIDON1_COMPRESSION at row 8 = POSEIDON1_COMPRESSION at row 0.

    const expr pow7Input[POSEIDON_WIDTH_GL];
    const expr pow7Shared[POSEIDON_WIDTH_GL];

    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        // INIT pre-ARC (round 0 only).
        pow7Input[i] = a[i + firstColP] + POSEIDON1_INIT * POSEIDON_C_GL[i];
    }
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        pow7Shared[i] = pow7(pow7Input[i]);
    }

    // 6 SEPARATE pow7 expressions for the overflow anchors[16..21] at row 0 cols 18..23.
    // Read from row 4 (PR fires) via prefix prime (4)'a[..].
    const expr pow7Overflow[6];
    for (int i = 0; i < 6; i++) {
        pow7Overflow[i] = pow7((4)'a[i + 18]);
    }

    // Per-round post-S-box ARC (Hades: added OUTSIDE pow7).
    const expr ARC[POSEIDON_WIDTH_GL];
    const expr preMat[POSEIDON_WIDTH_GL];
    const expr outputF[POSEIDON_WIDTH_GL];

    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        ARC[i] = POSEIDON1_R0       * POSEIDON_C_GL[i + 16]     // round 0
               + POSEIDON1_R1       * POSEIDON_C_GL[i + 32]     // round 1
               + POSEIDON1_R2       * POSEIDON_C_GL[i + 48]     // round 2
               + POSEIDON1_PR_PRIME * POSEIDON_C_GL[i + 64]     // round 3 (P-matrix)
               + POSEIDON1_R26      * POSEIDON_C_GL[i + 102]    // round 26
               + POSEIDON1_R27      * POSEIDON_C_GL[i + 118]    // round 27
               + POSEIDON1_R28      * POSEIDON_C_GL[i + 134];   // round 28
               // R29 (round 29) has no ARC

        preMat[i] = pow7Shared[i] + ARC[i];

        // Chain output destinations:
        //   rounds 0, 1, 2: NEXT row's chain slot (R1, R2, R3 at rows 1, 2, 3)
        //   rounds 26, 27, 28: NEXT row's chain slot (R27, R28, R29 at rows 6, 7, 8)
        //   round 29 (FINAL): SAME row's a[i] (output cells, DM-summed if COMPRESSION)
        //   round 3 (PR'): excluded — P-matrix output feeds the partial chain via 'fullRoundP
        //   PR (row 4): excluded — chain slot holds anchors
        // Davies-Meyer adds back the REORDERED (storage-order) input = R0
        // (a[i+firstColP] @ INIT), not the raw input a[i], so it matches the
        // prover, which hashes a node's children in fixed storage order and
        // adds that same ordered vector. R0 differs from raw input when key != 00.
        outputF[i] = (POSEIDON1_R0 + POSEIDON1_R1 + POSEIDON1_R2
                    + POSEIDON1_R26 + POSEIDON1_R27 + POSEIDON1_R28) * a[i + firstColP]'
                   + POSEIDON1_FINAL * (a[i] - (8)'POSEIDON1_COMPRESSION * (8)'a[i + firstColP]);
    }

    // INIT input-ordering: R0 (= a[i+firstColP] @ INIT) === permuted(input, key) for
    // CustPoseidon1 (Davies-Meyer compression), or R0 === input for plain Poseidon1.
    // Key bits at a[16], a[17] @ INIT row; helper also enforces binary check.
    const expr inputCells[POSEIDON_WIDTH_GL];
    const expr R0Cells[POSEIDON_WIDTH_GL];
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        inputCells[i] = a[i];
        R0Cells[i]    = a[i + firstColP];
    }
    const expr poseidon1Key[2] = [a[16], a[17]];
    poseidon1InputOrderGl(inputCells, poseidon1Key, R0Cells, POSEIDON1_COMPRESSION, POSEIDON1_SPONGE);

    const expr fullRound[POSEIDON_WIDTH_GL] = poseidonFullRoundGl(preMat);
    poseidonFullRoundCheckGl(fullRound, outputF,
        POSEIDON1_R0 + POSEIDON1_R1 + POSEIDON1_R2 + POSEIDON1_R26 + POSEIDON1_R27 + POSEIDON1_R28 + POSEIDON1_FINAL);

    // ── Round 3 → R4 (P-matrix transition, not stored) ──────────────────────────
    // fullRoundP[i] evaluated at row 3 = P × (pow7(R3) + C[i + 64]) = R4[i] expression.
    // R4 is NOT stored; the partial chain reads it via prefix prime 'fullRoundP from
    // row 4. The first anchor check enforces R4-consistency implicitly (degree 8).
    const expr fullRoundP[POSEIDON_WIDTH_GL] = poseidonPmatrixGl(preMat);

    // ── Single 22-round partial chain firing at PR (row 4) ──────────────────────
    // Anchors:
    //   row 4 a[36..51] = anchors[0..15]  (16 cells, chain slot — share pow7Shared)
    //   row 0 a[18..23] = anchors[16..21] (6 cells, plonk band — separate pow7 exprs)
    // Chain input  = 'fullRoundP[i] (degree-7 P-matrix expression from PR' row).
    // Chain output = R26 at row 5 chain slot (postfix prime from row 4).
    const expr st0Gl[22];
    const expr intermediateValuesGl[22];

    for (int r = 0; r < 16; r++) {
        st0Gl[r] = a[r + firstColP];                                                 // row 4 chain slot
        intermediateValuesGl[r] = pow7Shared[r] + POSEIDON_C_GL[80 + r];             // share pow7Shared
    }
    for (int r = 0; r < 6; r++) {
        st0Gl[16 + r] = (4)'a[r + 18];                                               // row 0 cols 18..23
        intermediateValuesGl[16 + r] = pow7Overflow[r] + POSEIDON_C_GL[96 + r];      // separate pow7
    }

    // Chain input/output:
    //   input  = 'fullRoundP[i] (degree-7 P-matrix expression from PR' row)
    //   output = R26 at row 5 chain slot (postfix prime from row 4)
    const expr inputPGl[POSEIDON_WIDTH_GL];
    const expr outputPGl[POSEIDON_WIDTH_GL];
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        inputPGl[i]  = 'fullRoundP[i];           // R4 expression (degree 7, from PR' row)
        outputPGl[i] = a[i + firstColP]';        // R26 at row 5 chain slot
    }

    const expr partialChainGl[22 + POSEIDON_WIDTH_GL] = poseidonPartialChainGl(22, 0, inputPGl, intermediateValuesGl);

    for (int r = 0; r < 22; r++) {
        POSEIDON1_PR * (st0Gl[r] - partialChainGl[r]) === 0;
    }
    for (int i = 0; i < POSEIDON_WIDTH_GL; i++) {
        POSEIDON1_PR * (outputPGl[i] - partialChainGl[22 + i]) === 0;
    }

    // ── Remaining custom-gate circuits ──────────────────────────────────────────
    const expr inA1[3] = [a[0], a[1], a[2]];
    const expr inB1[3] = [a[3], a[4], a[5]];
    const expr res[3] = [a[6], a[7], a[8]];
    cmul(inA1, inB1, res, CMUL);

    const expr inA2[3] = [a[9], a[10], a[11]];
    const expr inB2[3] = [a[12], a[13], a[14]];
    const expr res2[3] = [a[15], a[16], a[17]];
    cmul(inA2, inB2, res2, CMUL);

    const expr inA3[3] = [a[18], a[19], a[20]];
    const expr inB3[3] = [a[21], a[22], a[23]];
    const expr res3[3] = [a[24], a[25], a[26]];
    cmul(inA3, inB3, res3, CMUL);

    const expr inA4[3] = [a[27], a[28], a[29]];
    const expr inB4[3] = [a[30], a[31], a[32]];
    const expr res4[3] = [a[33], a[34], a[35]];
    cmul(inA4, inB4, res4, CMUL);

    const expr inpFFT[12] = [a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11]];
    const expr outFFT[12] = [a[12], a[13], a[14], a[15], a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23]];
    const expr constFFT[9] = [C[0], C[1], C[2], C[3], C[4], C[5], C[6], C[7], C[8]];
    fft4(inpFFT, constFFT, outFFT, FFT4);

    const expr coefs[5][3];
    coefs[0] = [a[12], a[13], a[14]];
    coefs[1] = [a[9], a[10], a[11]];
    coefs[2] = [a[6], a[7], a[8]];
    coefs[3] = [a[3], a[4], a[5]];
    coefs[4] = [a[0], a[1], a[2]];
    const expr x[3] = [a[15], a[16], a[17]];
    const expr resEVPOL[3] = [a[18], a[19], a[20]];
    evpol4(coefs, x, resEVPOL, EVPOL4);

    const expr treevals[8][3];
    treevals[0] = [a[0],  a[1],  a[2]];
    treevals[1] = [a[3],  a[4],  a[5]];
    treevals[2] = [a[6],  a[7],  a[8]];
    treevals[3] = [a[9],  a[10], a[11]];
    treevals[4] = [a[12], a[13], a[14]];
    treevals[5] = [a[15], a[16], a[17]];
    treevals[6] = [a[18], a[19], a[20]];
    treevals[7] = [a[21], a[22], a[23]];
    const expr key[3] = [a[24], a[25], a[26]];
    const expr resTREE[3] = [a[27], a[28], a[29]];
    treeselector8(treevals, key, resTREE, TREESELECTOR8);

    const expr selectvals[4][4];
    selectvals[0] = [a[0], a[1], a[2], a[3]];
    selectvals[1] = [a[4], a[5], a[6], a[7]];
    selectvals[2] = [a[8], a[9], a[10], a[11]];
    selectvals[3] = [a[12], a[13], a[14], a[15]];
    const expr selectvals_key[2] = [a[16], a[17]];
    const expr selected[4] = [a[18], a[19], a[20], a[21]];
    selectval1(selectvals, selectvals_key, selected, SELECTVAL1);

    const expr A[36];
    for (int i = 0; i < 36; i++) {
        A[i] = a[i];
    }
    connection(1, A, S, PIOP_BUS_PROD);
}
