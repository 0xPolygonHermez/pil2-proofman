require "std_constants.pil";
require "std_connection.pil";

require "circuits/plonk.pil";
require "circuits/poseidon_bn254.pil";

// ============================================================================
// PoseidonBN254 WRAP
//
// The AIR of the final SNARK wrap, over BN254, proved with pilfflonk: the circom verifier of the
// last STARK (`final.circom`, with custom templates) as PLONK gates and the custom gate
// `PoseidonT(5)`. Layout L1 (M45):
//
//   - 3 PLONK gates a row, gate g on a[3g..3g+2], all three with the row's one coefficient set C;
//   - a PoseidonT(5) use is a band of 69 rows, one round a row on a[0..4]: row r holds the state
//     before round r (the gate's `in` on row 0, `im[r - 1]` after), row 68 its `out`. PLONK gates 0
//     and 1 are off in the band, whose lanes they would read; gate 2 stays on, on a[6..8];
//   - the std's connection over every wire, a[0..8], on the product bus;
//   - the publics, each bound to a cell of the rows that follow the gates.
//
//   rows                 | a[0..4]               | a[5]       | a[6..8]      | selectors
//   ---------------------+-----------------------+------------+--------------+---------------------------
//   band row r, r < 68   | the state before r    | -          | PLONK gate 2 | POSEIDON, FULL or PARTIAL
//   band row 68          | out                   | -          | PLONK gate 2 | POSEIDON
//   PLONK rows           | PLONK gates 0 and 1 (a[0..5])      | PLONK gate 2 |
//   public rows          | the publics, 9 a row                              | PUBLICS_ROW on the first
//
// Every fixed column but the std's own (the connection's ID and __L1__) is computed by plonk2pil
// and given to the setup, `#pragma fixed_external`: the AIR's 2^22 rows would put the values of
// all of them above the 2 GiB a pilout can hold (M45). A row without a PLONK constraint has C = 0,
// so its gates hold whatever the row's cells.
// ============================================================================
airtemplate Wrap (const int N, const int nPublics) {
    const int nWires = 9;

    col witness a[nWires];

    #pragma fixed_external
    col fixed S[nWires];

    // [qM, qL, qR, qO, qC] of the row's gates.
    #pragma fixed_external
    col fixed C[5];

    // The round constants of the row's round: C[5·r + j] of POSEIDON_C_ORIGINAL(5) on band row r.
    #pragma fixed_external
    col fixed POSEIDON_RC[POSEIDON_BN254_WIDTH];

    // 1 on every row of a band; 1 on the rows of a full round, and of a partial round.
    #pragma fixed_external
    col fixed POSEIDON;
    #pragma fixed_external
    col fixed POSEIDON_FULL_ROUND;
    #pragma fixed_external
    col fixed POSEIDON_PARTIAL_ROUND;

    if (nPublics > 0) {
        // 1 on the first public row: public i is a[i % 9] of the (i / 9)-th row from it.
        #pragma fixed_external
        col fixed PUBLICS_ROW;
        for (int i = 0; i < nPublics; i++) {
            (i / nWires)'PUBLICS_ROW * (a[i % nWires] - publics[i]) === 0;
        }
    }

    const expr q[5] = [C[0], C[1], C[2], C[3], C[4]];
    plonk([a[0], a[1], a[2]], q, 1 - POSEIDON);
    plonk([a[3], a[4], a[5]], q, 1 - POSEIDON);
    plonk([a[6], a[7], a[8]], q, 1);

    const expr state[POSEIDON_BN254_WIDTH];
    const expr next[POSEIDON_BN254_WIDTH];
    const expr rc[POSEIDON_BN254_WIDTH];
    for (int j = 0; j < POSEIDON_BN254_WIDTH; j++) {
        state[j] = a[j];
        next[j] = a[j]';
        rc[j] = POSEIDON_RC[j];
    }
    poseidonBn254Round(state, next, rc, POSEIDON_FULL_ROUND, POSEIDON_PARTIAL_ROUND);

    const expr wires[nWires];
    for (int i = 0; i < nWires; i++) {
        wires[i] = a[i];
    }
    connection(1, wires, S, PIOP_BUS_PROD);
}
