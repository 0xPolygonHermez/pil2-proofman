// TREESELECTOR4 GATE - Given 4 values (each a 3-element vector) and a 2-bit key,
// pick the value whose index equals the key (key[0] = LSB, key[1] = MSB).
function treeselector4(const expr vals[][], const expr key[], const expr res[], const expr sel) {

    const expr nk0 = 1 - key[0];
    const expr nk1 = 1 - key[1];

    const expr m[4];
    m[0] = nk0   * nk1;    // 00
    m[1] = key[0]* nk1;    // 10  (k0 = 1)
    m[2] = nk0   * key[1]; // 01  (k1 = 1)
    m[3] = key[0]* key[1]; // 11

    for (int j = 0; j < 3; j++) {
        sel * ((m[0]*vals[0][j] + m[1]*vals[1][j] + m[2]*vals[2][j] + m[3]*vals[3][j]) - res[j]) === 0;
    }

    sel * (key[0] * (1 - key[0])) === 0;
    sel * (key[1] * (1 - key[1])) === 0;
}

// TREESELECTOR4 with the one-hot mask read from stored cells (the gate's im_m[4]) instead of
// derived from the key bits, so the selection is degree 2 and sel * selection is 3. Same
// pinning argument as treeselector8Mask, with two key bits instead of three.
function treeselector4Mask(const expr vals[][], const expr key[], const expr m[], const expr res[], const expr sel) {

    for (int i = 0; i < 4; i++) {
        sel * (m[i] * (1 - m[i])) === 0;
    }

    sel * (((m[0] + m[1]) + m[2]) + m[3] - 1) === 0;
    sel * ((m[1] + m[3]) - key[0]) === 0;
    sel * ((m[2] + m[3]) - key[1]) === 0;

    for (int j = 0; j < 3; j++) {
        sel * ((m[0]*vals[0][j] + m[1]*vals[1][j] + m[2]*vals[2][j] + m[3]*vals[3][j]) - res[j]) === 0;
    }
}

// TREESELECTOR8 GATE - Given 8 values (each a 3-element vector) and a 3-bit key,
// pick the value whose index equals the key (key[0] = LSB, key[2] = MSB).
//
// The tree is created as follows: at every level, if key[i] = 0 we push the even
// positions, if key[i] = 1 we push the odd ones. With key = [k0, k1, k2]:
//   [v0..v7] → [v_{k0}, v_{k0+2}, v_{k0+4}, v_{k0+6}] → [v_{k0+2*k1}, v_{k0+2*k1+4}] → v_{k0+2*k1+4*k2}.
//
// Layout (30 cells = exact plonk-band width when 10 plonk gates × 3 cells):
//   vals[0..7] × 3 cells  → a[0..23]
//   key[3]                → a[24..26]
//   res[3]                → a[27..29]
function treeselector8(const expr vals[][], const expr key[], const expr res[], const expr sel) {

    const expr nk0 = 1 - key[0];
    const expr nk1 = 1 - key[1];
    const expr nk2 = 1 - key[2];

    const expr m[8];
    m[0] = nk0   * nk1   * nk2;     // 000
    m[1] = key[0]* nk1   * nk2;     // 100  (k0 = 1)
    m[2] = nk0   * key[1]* nk2;     // 010  (k1 = 1)
    m[3] = key[0]* key[1]* nk2;     // 110
    m[4] = nk0   * nk1   * key[2];  // 001  (k2 = 1)
    m[5] = key[0]* nk1   * key[2];  // 101
    m[6] = nk0   * key[1]* key[2];  // 011
    m[7] = key[0]* key[1]* key[2];  // 111

    for (int j = 0; j < 3; j++) {
        sel * ((m[0]*vals[0][j] + m[1]*vals[1][j] + m[2]*vals[2][j] + m[3]*vals[3][j] + m[4]*vals[4][j] + m[5]*vals[5][j] + m[6]*vals[6][j] + m[7]*vals[7][j]) - res[j]) === 0;
    }

    sel * (key[0] * (1 - key[0])) === 0;
    sel * (key[1] * (1 - key[1])) === 0;
    sel * (key[2] * (1 - key[2])) === 0;
}

// TREESELECTOR8 with the one-hot mask read from the gate's im_m[8] cells: stored it is degree 1,
// so the selection is degree 3 rather than 5. Binary + sum-to-1 + one bit-extraction row per key
// bit force m to be the one-hot of the keys (if m[t] is the single 1, those rows read off the
// binary digits of t), which also makes the keys binary for free.
function treeselector8Mask(const expr vals[][], const expr key[], const expr m[], const expr res[], const expr sel) {

    for (int i = 0; i < 8; i++) {
        sel * (m[i] * (1 - m[i])) === 0;
    }

    sel * (((((((m[0] + m[1]) + m[2]) + m[3]) + m[4]) + m[5]) + m[6]) + m[7] - 1) === 0;

    // Bit 0 is set for indices 1,3,5,7; bit 1 for 2,3,6,7; bit 2 for 4,5,6,7.
    sel * ((((m[1] + m[3]) + m[5]) + m[7]) - key[0]) === 0;
    sel * ((((m[2] + m[3]) + m[6]) + m[7]) - key[1]) === 0;
    sel * ((((m[4] + m[5]) + m[6]) + m[7]) - key[2]) === 0;

    for (int j = 0; j < 3; j++) {
        sel * ((m[0]*vals[0][j] + m[1]*vals[1][j] + m[2]*vals[2][j] + m[3]*vals[3][j]
              + m[4]*vals[4][j] + m[5]*vals[5][j] + m[6]*vals[6][j] + m[7]*vals[7][j]) - res[j]) === 0;
    }
}
