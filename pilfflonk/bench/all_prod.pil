// The `all` of tests/fixtures/all/all_prod.pil at N = 2^BENCH_BITS, for the benchmark (bench.sh,
// pilfflonk/docs/performance.md#cpu): the fixture's airtemplate, on the std's product bus in
// STD_MODE_ONE_INSTANCE, with the airgroup taking N from the compiler (the fixture's, 2^8).
//
// BENCH_BITS is a define of pil2com: bench.sh compiles with --field bn128, -D BENCH_BITS=<bits>
// and -I pil2-components/lib/std/pil. The witness is
// tests/data/all.rs's for 2^BENCH_BITS rows (`witness_of_size`), the same for both buses.
require "../tests/fixtures/all/all.pil"

set_std_mode(STD_MODE_ONE_INSTANCE);

airgroup All {
    All(N: 2**BENCH_BITS, bus_type: PIOP_BUS_PROD);
}
