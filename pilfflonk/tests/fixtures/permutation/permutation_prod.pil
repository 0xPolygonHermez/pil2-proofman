// The Permutation of permutation.pil on the std's product bus (a grand product), in
// STD_MODE_ONE_INSTANCE. The std's default MAX_CONSTRAINT_DEGREE (3) gives one im_col.
require "permutation.pil"

set_std_mode(STD_MODE_ONE_INSTANCE);

airgroup Permutation {
    Permutation(bus_type: PIOP_BUS_PROD);
}
