// The std's two buses in one AIR (pilfflonk/docs/README.md#fixtures): the Connection of
// tests/fixtures/connection/connection.pil on the product bus (PIOP_BUS_PROD, a grand product) and
// the Plookup of tests/fixtures/plookup/plookup.pil on the sum bus (PIOP_BUS_SUM, LogUp), as
// plonk2pil's BN254 wrap has its connection and the lookup of its range checks. N = 2^8, as `all`.
// Each bus closes on its own, in STD_MODE_ONE_INSTANCE: `gprod` at 1 and `gsum` at 0 on the last
// row. The std's default MAX_CONSTRAINT_DEGREE (3).
//
// The program to compile, over BN254 as the Fibonacci (tests/fixtures/fibonacci/fibonacci.pil),
// with --field bn254 and -I pil2-components/lib/std/pil. The witness generator is
// tests/data/mixed_bus.rs.
require "std_constants.pil"
require "../connection/connection.pil"
require "../plookup/plookup.pil"

set_std_mode(STD_MODE_ONE_INSTANCE);

airtemplate MixedBus(const int N = 2**8) {
    col witness connection_a, connection_b, connection_c;
    sm_connection(connection_a, connection_b, connection_c, PIOP_BUS_PROD);

    col witness plookup_sel, plookup_a, plookup_b;
    col witness plookup_cc;
    col witness plookup_mul;
    sm_plookup(plookup_sel, plookup_a, plookup_b, plookup_cc, plookup_mul, PIOP_BUS_SUM);
}

airgroup MixedBus {
    MixedBus();
}
