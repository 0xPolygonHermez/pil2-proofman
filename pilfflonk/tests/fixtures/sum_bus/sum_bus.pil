// A sum bus in one AIR (plan M30): a lookup of the pairs (a, b) into the fixed table of pairs
// (T, TT) = (i, i²), each row of the table proved `mul` times, on the std's LogUp bus (gsum) in
// STD_MODE_ONE_INSTANCE, which has no airgroup value (D2). One air, one instance, N = 2^5.
//
// - The std's prover hint gsum_col gives the stage-2 column `gsum`, with the challenges std_alpha
//   and std_gamma: row by row, the running sum of mul/(T + TT·α + 1·α² …) − 1/(a + b·α …), each
//   pair compressed as busid + e_1·α + e_2·α² (std_tools.pil, compress_exprs) and shifted by γ. Its
//   last row is 0 if and only if the bus balances: `L1'·(0 − gsum) === 0`.
// - Both terms go in one fraction of denominator degree 2, which the std's default
//   MAX_CONSTRAINT_DEGREE (3) does not allow without an im_col (std_sum.pil, piop_gsum_air), and
//   pilfflonk does not compute im_col yet (plan M31): the degree is raised to 4. No term is a
//   constant, so there is no im_airval either.
// - `first` is a[0], so that a public ties the witness.
//
// Compile over BN254 as the Fibonacci (tests/fixtures/fibonacci/fibonacci.pil), with its
// bn254.json and -I pil2-components/lib/std/pil. The witness generator is tests/data/sum_bus.rs.
require "std_constants.pil"
require "std_lookup.pil"

set_std_mode(STD_MODE_ONE_INSTANCE);
set_max_constraint_degree(4);

public first;

airtemplate SumBus(const int N = 2**5) {
    col fixed T = [0..(N-1)];
    col fixed TT;
    for (int i = 0; i < N; i++) {
        TT[i] = i * i;
    }

    col witness a, b, mul;

    lookup_assumes(1, [a, b]);
    lookup_proves(1, [T, TT], mul);

    const expr L1 = get_L1();
    L1 * (a - first) === 0;
}

airgroup SumBus {
    SumBus();
}
